// `coordinator_adopt`: a coordinator adopts one worker, into **this plugin's own ledger**.
//
// Adoption is coordination domain, and it lives here — not in core. The operator's ruling
// (2026-10-29) puts the ledger, the epochs, supervision, release-of-monitoring, notice
// obligations and the coordination decisions in the plugin, and keeps only generic resource
// ownership in the harness. So this file calls **no** core adoption verb: there is none to call,
// and `custody_adopt` is leaving core. The durable fact of an adoption is a row in `plugin_state`,
// written by this tool, and the halt handler reads its watch list from the same row.
//
// The guards, in the service's order (`reports/coordinator-retirement-2026-10-28/verb-contracts.md`
// § adopt), which is now this file's own contract because there is no door beneath it:
//   1. `worker` non-empty — a sentence that names what is missing, not a silent no-op.
//   2. `a session cannot adopt itself` — an adoption is one session's act about another.
//   3. no **live** adoption of that worker in this ledger. A re-adoption is a **new epoch**,
//      never a second live row, and the refusal names the epoch and points at release.
//   4. the epoch is this ledger's own **next number** — `max(epoch) + 1` over that worker's
//      rows, never supplied by a caller and never read out of prose.
//   5. **durable before the answer**: the row is written and read back first; an uncertain write
//      says so and claims nothing.
//   6. the answer distinguishes a live session carrying the address from a record kept against an
//      address that is never rebound to whatever looks similar.

pub fn manifest() {
    #{
        name: "coordinator_adopt",
        description: "Adopt a worker session, explicitly and by durable address, through the harness's custody door: from then on this session is its coordinator, and the halt handler announces one notice per observed halt of it. The address is the harness's, echoed verbatim — never a display name and never a tag. Adoption confers no authority over the worker: it routes notices and nothing else. A second record is kept in this plugin's own ledger, because that is where the halt handler reads its watch list from; the answer says what the harness adopted and what this ledger recorded.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "session": #{
                    "type": "string",
                    "description": "The worker's durable address, exactly as `eidolon peers` prints it. Echoed verbatim; this plugin never canonicalises, shortens or path-joins it, and never matches a name to find it.",
                },
                "name": #{
                    "type": "string",
                    "description": "What this coordinator calls the worker. Display and search only: a name routes nothing, grants nothing, and is never how a worker is found.",
                },
                "note": #{
                    "type": "string",
                    "description": "Free text kept with the record: the assignment. It is not a status and not evidence about the worker — declared text never overrides what the harness observes.",
                },
            },
            "required": ["session"],
        },
    }
}

pub async fn call(input) {
    let worker = match text_of(input.get("session")) {
        Some(s) => s,
        None => return Err("coordinator_adopt needs `session`: the worker's durable address, exactly as `eidolon peers` prints it — never a display name"),
    };
    match refuse_control_chars("session", worker) {
        Some(e) => return Err(e),
        None => {}
    }
    // Guard 1, which the schema cannot keep: `required` refuses a *missing* field, and `""` is a
    // string. An empty address would write a live row that names nobody — core's own
    // `adopt_refuses_an_empty_worker_address` guarded this before the verb left, and the row this
    // ledger keeps is the only record an adoption has.
    if worker == "" {
        return Err("coordinator_adopt needs a durable address: `session` is empty, and an empty address names no worker — pass the address exactly as `eidolon peers` prints it");
    }
    let name = match text_of(input.get("name")) {
        Some(s) => s,
        None => "",
    };
    let note = match text_of(input.get("note")) {
        Some(s) => s,
        None => "",
    };

    // This session's own address is not an argument and is not sent anywhere: the ledger is
    // already keyed by `(session, plugin)`, so the adopting session is the one running this tool.
    // It is read for two local facts only — the courtesy self-adoption refusal, and the `coordinator`
    // field the notice id is derived over. A roster that cannot say leaves both unstated rather than
    // refusing the adoption, because the adoption is this ledger's act.
    let caller = own_address().await;
    if caller != "" && caller == worker {
        return Err(`a session cannot adopt itself (${worker}): an adoption is one session's act about another, and this session is that one`);
    }

    let attempt = 0;
    let refusal = "";
    while attempt < 2 {
        attempt += 1;
        let loaded = load_store().await?;
        let store = loaded.store;
        let adoptions = store_list(store, "adoptions");

        // The live row, if this ledger holds one — the guard the door used to keep for us.
        let existing = #{};
        let live = false;
        let high = 0;
        for a in adoptions {
            if a is Object && ledger_text(a, "worker") == worker {
                if !ledger_released(a) {
                    existing = a;
                    live = true;
                }
                if ledger_stated(a, "epoch") {
                    let e = ledger_number(a, "epoch");
                    if e > high {
                        high = e;
                    }
                }
            }
        }
        if live {
            return Err(`${worker} is already adopted by this session, in epoch ${lifecycle_epoch_word(existing, "epoch")} and still monitored; \`coordinator_release\` ends it first (a re-adoption is a new epoch, not a second live one)`);
        }

        // The next number **this ledger** has not used for that worker. The service's `next_epoch`,
        // now that the number is the plugin's to keep: one past the highest epoch that worker has
        // ever had here, so a release and re-adoption is a new epoch rather than a reused one.
        let epoch = high + 1;
        let row = #{
            "worker": worker,
            "name": name,
            "note": note,
            "coordinator": caller,
            "epoch": epoch,
        };
        adoptions.push(row);
        let wrote = write_store(store_put(store, "adoptions", adoptions), loaded.revision).await?;
        let status = ledger_text(wrote, "status");
        if status == "written" {
            return Ok(`adopted ${worker} in epoch ${epoch}. ${live_sentence(caller, worker).await} This ledger is the record: the halt handler reads its watch list from this row, and no harness record mirrors it.`);
        }
        if status == "uncertain" {
            return Ok(`the adoption of ${worker} in epoch ${epoch} **may or may not be written down**: this ledger's write came back uncertain (${ledger_text(wrote, "detail")}), and an uncertain write is not a fact. Adopt again — an adoption this ledger did write is found by the retry and answered with its epoch rather than duplicated.`);
        }
        refusal = ledger_text(wrote, "detail");
    }
    Err(`the adoption of ${worker} was **not written down**, so it did not happen (${refusal}). Nothing is claimed: retry, and a write that lands will be the record`);
}

// The service's two answers to "what did you see at that address", kept because they keep a live
// session apart from a record that must never be rebound to whatever looks similar.
async fn live_sentence(coordinator, worker) {
    let raw = match eidolon::swarm_call("roster", #{}).await {
        Ok(v) => v,
        Err(_) => return "The roster could not be read, so this adoption says nothing about whether a live session carries that address: it is a record, and a record is not a liveness claim.",
    };
    let roster = match json::from_string(raw) {
        Ok(v) => v,
        Err(_) => return "The roster answered something that is not JSON, so this adoption says nothing about liveness.",
    };
    let rows = roster_rows(roster);
    let claimants = claimants(rows, worker);
    if claimants.len() == 1 {
        let r = claimants[0];
        let state = ledger_text(r, "state");
        let last = ledger_text(r, "last");
        return format_live(state, last);
    }
    if claimants.len() > 1 {
        return (`${claimants.len()} live sessions claim that address; refusing to guess which one this adoption is about.`);
    }
    "No live session carries that address right now — the record is kept, and the address is never rebound to whatever looks similar: if the harness's spelling has changed, the adoption has to be released and made again."
}

fn format_live(state, last) {
    `A live session carries that address now: state \`${state}\`, last \`${last}\`. It is monitored from now on — one notice per observed halt, to this session.`
}

// This session's own address, best effort: "" when the roster cannot say. An adoption is
// the harness's act and must not be refused because this plugin cannot see its own row.
async fn own_address() {
    let raw = match eidolon::swarm_call("roster", #{}).await {
        Ok(v) => v,
        Err(_) => return "",
    };
    let roster = match json::from_string(raw) {
        Ok(v) => v,
        Err(_) => return "",
    };
    let me = match my_row(roster) {
        Some(r) => r,
        None => return "",
    };
    match me.get("session") {
        Some(s) => {
            let addr = `${s}`;
            if addr == "null" {
                return "";
            }
            addr
        }
        None => "",
    }
}

fn my_row(roster) {
    if roster is Object {
        match roster.get("me") {
            Some(m) => {
                if m is Object {
                    return Some(m);
                }
                return None;
            }
            None => {}
        }
    }
    if roster is Vec {
        for row in roster {
            match row.get("me") {
                Some(flag) => {
                    if `${flag}` == "true" {
                        return Some(row);
                    }
                }
                None => {}
            }
        }
    }
    None
}

fn roster_rows(roster) {
    let out = [];
    if roster is Vec {
        return roster;
    }
    if roster is Object {
        match roster.get("sessions") {
            Some(s) => {
                if s is Vec {
                    for row in s {
                        out.push(row);
                    }
                }
            }
            None => {}
        }
        match roster.get("me") {
            Some(me) => {
                if me is Object {
                    let session = ledger_text(me, "session");
                    let seen = false;
                    for row in out {
                        if ledger_text(row, "session") == session {
                            seen = true;
                            break;
                        }
                    }
                    if !seen {
                        out.push(me);
                    }
                }
            }
            None => {}
        }
    }
    return out;
}

fn claimants(rows, session) {
    let out = [];
    if session == "" {
        return out;
    }
    for row in rows {
        if row is Object && ledger_text(row, "session") == session {
            out.push(row);
        }
    }
    out
}

fn text_of(v) {
    match v {
        Some(x) => {
            if x is String {
                let s = `${x}`;
                if s == "null" {
                    None
                } else {
                    Some(s)
                }
            } else {
                None
            }
        }
        None => None,
    }
}

// A durable address is one path-component-shaped word: a control character in it would
// be a forged line in whatever prints it next.
fn refuse_control_chars(field, s) {
    for c in s.chars() {
        let n = `${c}`;
        if n == "\\n" || n == "\\r" || n == "\\t" {
            return Some(`\`${field}\` carries a control character; an address is one word, and a line break in it would be a forged line wherever it is printed`);
        }
    }
    None
}

// ---- the ledger, and the pure policy this tool repeats ---------------------
//
// Upstream compiles every `tools/*.rn` on its own and compiles `lib/` only in front of
// workflows, so the policy cannot be imported here. Everything from `lifecycle_stated`
// down is the library's text, emitted by `tests/coordinator/lifecycle-copies.py --write`;
// `lifecycle-drift.sh` fails if it drifts.

async fn load_store() {
    let raw = eidolon::plugin_state_read(#{ "key": "store" }).await?;
    let reply = json::from_string(raw)?;
    let revision = lifecycle_number(reply, "revision");
    let store = lifecycle_store_empty();
    match reply.get("value") {
        Some(v) => {
            if lifecycle_null(v) {
                // Nothing written yet. `revision: 0, value: null` is the fact a first write
                // compares against, not a corrupt row — and a *fresh* ledger is the ordinary
                // case for a session whose first act is an adoption. Reading it as corruption
                // refused every handler on a session that had not seeded a store first, which
                // is what every test did and why this was invisible.
            } else if v is String {
                let got = json::from_string(`${v}`)?;
                if got is Object {
                    store = got;
                } else {
                    return Err(`the \`store\` row is not the object this ledger writes (${v}); it is refused rather than repaired or overwritten`);
                }
            } else {
                return Err("the `store` row's value is not the JSON text this ledger writes; it is refused rather than repaired or overwritten");
            }
        }
        None => {}
    }
    for key in ["adoptions", "notices", "gaps"] {
        store = lifecycle_store_put(store, key, lifecycle_store_list(store, key)?);
    }
    Ok(#{ "store": store, "revision": revision })
}

async fn write_store(store, revision) {
    let text = json::to_string(store)?;
    match eidolon::plugin_state_write(#{ "key": "store", "value": text, "revision": revision }).await {
        Ok(_) => {
            let check = json::from_string(eidolon::plugin_state_read(#{ "key": "store" }).await?)?;
            match check.get("value") {
                Some(v) => {
                    if v is String && `${v}` == text {
                        Ok(#{ "status": "written", "revision": lifecycle_number(check, "revision") })
                    } else {
                        Ok(#{ "status": "uncertain", "detail": "the read-back did not carry the bytes just written" })
                    }
                }
                None => Ok(#{ "status": "uncertain", "detail": "the read-back carried no value" }),
            }
        }
        Err(e) => {
            let check = match json::from_string(eidolon::plugin_state_read(#{ "key": "store" }).await?) {
                Ok(v) => v,
                Err(bad) => return Ok(#{ "status": "uncertain", "detail": `the write was refused (${e}) and the read-back would not parse (${bad})` }),
            };
            let same = false;
            match check.get("value") {
                Some(v) => {
                    if v is String && `${v}` == text {
                        same = true;
                    }
                }
                None => {}
            }
            if same {
                Ok(#{ "status": "uncertain", "detail": `the write answered an error (${e}) and the bytes are now at the path: it may have landed` })
            } else {
                Ok(#{ "status": "refused", "detail": `${e}` })
            }
        }
    }
}

// The three readers this file needs under names of its own, so a caller reads a sentence
// rather than a library idiom. Each is one line over the generated policy below.
fn ledger_text(row, key) {
    lifecycle_text(row, key)
}

fn ledger_number(row, key) {
    lifecycle_number(row, key)
}

fn ledger_released(row) {
    lifecycle_released(row)
}

fn ledger_stated(row, key) {
    lifecycle_stated(row, key)
}

fn store_list(store, key) {
    lifecycle_store_list(store, key)?
}

fn store_put(store, key, list) {
    lifecycle_store_put(store, key, list)
}
// --- generated: the policy copy, from coordinator/lib/lifecycle.rn ---
//
// Do not edit these: they are the library's text. `--write` emits them and
// `lifecycle-drift.sh` fails if they differ from it by one byte — the whole region
// is compared against what the generator produces, so renaming a copy does not
// exempt it. Edit `coordinator/lib/lifecycle.rn`, then run `--write`.
// stamp: sha256:495cda0441adb5e72bd5554f59eb8e736e3b7c601503a0d331e26447a99ff9c2

fn lifecycle_true(v) {
    match v {
        Some(b) => {
            if lifecycle_null(b) {
                false
            } else if b is bool {
                b
            } else {
                `${b}` == "true"
            }
        }
        None => false,
    }
}
fn lifecycle_stated(row, key) {
    match row.get(key) {
        Some(v) => !lifecycle_null(v),
        None => false,
    }
}
fn lifecycle_epoch_word(row, key) {
    if !lifecycle_stated(row, key) {
        return "not stated";
    }
    `${lifecycle_number(row, key)}`
}
fn lifecycle_store_empty() {
    #{ "adoptions": [], "notices": [], "gaps": [] }
}
fn lifecycle_store_list(store, key) {
    match store.get(key) {
        None => Ok([]),
        Some(v) => {
            if v is Vec {
                Ok(v)
            } else {
                Err(`the store's \`${key}\` is not a list (${v}); it is refused rather than repaired or overwritten`)
            }
        }
    }
}
fn lifecycle_store_put(store, key, list) {
    store.insert(key, list);
    store
}
fn lifecycle_text(row, key) {
    match row.get(key) {
        Some(v) => {
            if lifecycle_null(v) {
                ""
            } else {
                `${v}`
            }
        }
        None => "",
    }
}
fn lifecycle_number(row, key) {
    match row.get(key) {
        Some(v) => {
            if lifecycle_null(v) {
                0
            } else if v is i64 || v is u64 {
                v
            } else {
                match `${v}`.parse::<i64>() {
                    Ok(n) => n,
                    Err(_) => 0,
                }
            }
        }
        None => 0,
    }
}
fn lifecycle_released(row) {
    if lifecycle_true(row.get("released")) {
        return true;
    }
    match row.get("released_at_ms") {
        Some(v) => !lifecycle_null(v),
        None => false,
    }
}
fn lifecycle_null(v) {
    if v is String && `${v}` == "" {
        return true;
    }
    match json::to_string(v) {
        Ok(s) => s == "null",
        Err(_) => false,
    }
}
