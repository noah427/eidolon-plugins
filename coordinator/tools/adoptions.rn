// `coordinator_adoptions`: what this session has adopted, what each adopted worker
// is doing now, and what this tool can and cannot check.
//
// The rows are this plugin's own ledger — written by `adopt`, released by `release`,
// watched by `hook_peer` — read beside a live roster. That is **two** sources, not
// one, and the difference is the point: the harness publishes no way to read an
// adoption record back, so a row here is what this plugin wrote and never a record
// verified against the custody log. Every row says so, and so does the header.
//
// Liveness is reported beside the state and never folded into it, and the three
// answers stay apart exactly as the service kept them apart: `unobservable` when the
// roster could not be read, `no live session carries this address` when it could be
// read and found none, and `live as …` when it found one.
pub fn manifest() {
    #{
        name: "coordinator_adoptions",
        description: "Every adoption this session has made, and for each: the worker's durable address as it was recorded, what this coordinator calls it, the epoch it was adopted in, whether it is still monitored or has been released, whether a live session carries that address right now, the state and last outcome the harness publishes for it, and whether the row could be checked against the custody log at all. Read-only. Names and tags appear as what they are — display — and are never how a worker is found.",
        approval: "read_only",
        input_schema: #{
            "type": "object",
            "properties": #{},
        },
    }
}

pub async fn call(input) {
    let loaded = load_store().await?;
    let store = loaded.store;
    let adoptions = lifecycle_store_list(store, "adoptions")?;
    let starts = load_list("starts").await?;

    // The roster, read once, with the harness's own refusal words kept verbatim: it
    // either answers rows or says why it cannot, and the second is not an empty list.
    let rows = [];
    let unseen = "";
    match eidolon::swarm_call("roster", #{}).await {
        Ok(raw) => {
            match json::from_string(raw) {
                Ok(roster) => {
                    rows = roster_rows(roster);
                }
                Err(e) => {
                    unseen = `the roster answered something that is not JSON: ${e}; it answered: ${raw}`;
                }
            }
        }
        Err(e) => {
            unseen = `${e}`;
        }
    }

    let out = "";
    let addresses = false;
    for row in rows {
        if row is Object && lifecycle_text(row, "session") != "" {
            addresses = true;
        }
    }

    if unseen != "" {
        out += `the monitor cannot see the workers: ${unseen}\nNothing below is a claim about any worker's state.\n`;
    } else if rows.len() > 0 && !addresses {
        out += "the roster publishes no `session` for any live row: a session with no log has no id to name, so no adoption can be resolved to one. Null means not established, not no-such-session.\n";
    }

    // Which facts here are checked, and which are not. The custody doors are attached in
    // this harness now, and `eidolon::custody_inspect` answers for one thing: a **managed
    // start's operation**. A start row is therefore checked against the log and marked
    // `verified against the log`, or marked with the refusal when the log does not know it.
    // An **adoption** has no operation, and no primitive reads an adoption back by worker —
    // the one oracle is `custody_adopt`'s own refusal at write time — so an adoption row
    // stays `store only`, and that is a narrower claim than it used to be.
    out += "\nA **managed start** row is checked against the custody log with one `custody_inspect` per operation, and says which it is: `verified against the log`, or `store only` with the log's refusal. The adoption epoch on that line says where it came from: the log's own field, or — because epochs are the plugin's under the 2026-10-29 ruling — this ledger's record of the same start. A verified row is verified for what the log answered; it is not a claim that every field came from the log. An **adoption** row is `store only`: no primitive reads an adoption back by worker — `custody_inspect` answers for an operation, and an adoption has none — so an adoption row is what this plugin wrote down, and the only oracle for it is `custody_adopt`'s refusal at the moment of writing.\n\n";

    // The service's own rendering of a managed start, kept because it is the
    // vocabulary an operator has already read: the durable phase is history, not
    // current liveness.
    for start in starts {
        if !(start is Object) {
            out += "a managed-start row is not an object; it is shown as it stands\n";
            continue;
        }
        let operation = lifecycle_text(start, "operation");
        // One `custody_inspect` per operation: cheap at this scale (the operator's whole
        // store is 94 starts), and it is the only way a start row can be a *checked* fact
        // rather than a memory.
        match eidolon::custody_inspect(#{ "operation": operation }).await {
            Ok(raw) => {
                let view = match json::from_string(raw) {
                    Ok(v) => v,
                    Err(e) => {
                        out += `managed start ${operation}: the custody log answered something that is not JSON (${e})\n  store only\n`;
                        continue;
                    }
                };
                let epoch = start_epoch_and_source(start, view, true, adoptions);
                out += `managed start ${operation}: ${start_rank_word(start)}; phase ${lifecycle_text(view, "phase")}, session ${lifecycle_text(view, "session")}, adoption epoch ${epoch.word} (${epoch.source})\n`;
                out += `  cancellation: ${start_cancellation(view)} (historical exit receipt, not current liveness)\n`;
                out += "  verified against the log\n";
            }
            Err(e) => {
                let epoch = start_epoch_and_source(start, #{}, false, adoptions);
                out += `managed start ${operation}: ${start_rank_word(start)}; this ledger records phase ${lifecycle_text(start, "phase")}, session ${lifecycle_text(start, "session")}, adoption epoch ${epoch.word} (${epoch.source})\n`;
                out += `  cancellation: ${start_cancellation(start)} (historical exit receipt, not current liveness)\n`;
                out += `  store only — the custody log does not answer for this operation: ${e}\n`;
            }
        }
    }
    if starts.len() > 0 {
        out += "\n";
    }

    let any = false;
    for row in adoptions {
        if !(row is Object) {
            out += "an adoption row is not an object; it is shown as it stands\n";
            continue;
        }
        any = true;
        let worker = lifecycle_text(row, "worker");
        let name = lifecycle_text(row, "name");
        out += `epoch ${lifecycle_epoch_word(row, "epoch")} — ${worker}${if name == "" { "" } else { ` (called \`${name}\`)` }}\n`;
        out += "  adopted: the time is not stated by this plugin (no clock in the script vocabulary)\n";
        if lifecycle_released(row) {
            let at = lifecycle_text(row, "released_at_ms");
            let said = lifecycle_text(row, "release_reason");
            if at == "" {
                out += "  RELEASED; not monitored\n";
            } else {
                out += `  RELEASED at ${at} (as it was recorded when the release was written); not monitored\n`;
            }
            if said != "" {
                out += `  released because: ${said}\n`;
            }
        } else {
            out += "  monitored\n";
            // A cancellation whose exit this plugin never saw is the one thing that stops a
            // release, so it is said here rather than left to the refusal to explain later. The
            // word is core's, recorded by `coordinator_cancel` from the log's typed field.
            let cancel = lifecycle_text(row, "cancellation");
            if cancel != "" {
                let op = lifecycle_text(row, "cancel_operation");
                let said = lifecycle_text(row, "cancel_reason");
                let which = "";
                if op != "" {
                    which = ` of ${op}`;
                }
                let why = "";
                if said != "" {
                    why = ` (the reason it was asked for: ${said})`;
                }
                out += `  cancellation \`${cancel}\`${which} — core's own outcome word; this plugin observed none of it, and a release is refused while that word is \`attempted\`${why}\n`;
            }
        }
        out += `  ${live_line(rows, worker, unseen)}\n`;
        let note = lifecycle_text(row, "note");
        if note != "" {
            out += `  note: ${note}\n`;
        }
        out += "  store only\n";
    }
    if !any {
        out += "no adoptions recorded by this session.\n";
    }

    // The last scan's own words, from the ledger: this is the blindness the service
    // reported per row and per answer, and it is the only place it is kept at all.
    let blind = lifecycle_blind_notes(store);
    let notes = blind.notes;
    let uncertain = blind.uncertain;
    if notes.len() == 0 && uncertain.len() == 0 {
        out += "\nthe last scan said: nothing recorded — and a scan that said nothing is not a scan that saw nothing.\n";
    } else {
        out += "\nthe last scan said:\n";
        for line in notes {
            out += `  - ${line}\n`;
        }
        if uncertain.len() > 0 {
            out += "uncertain (not recorded as done):\n";
            for line in uncertain {
                out += `  - ${line}\n`;
            }
        }
    }
    Ok(out)
}

// The service's live line, kept word for word, with its three answers apart.
fn live_line(rows, worker, unseen) {
    if unseen != "" {
        return "unobservable";
    }
    let claimants = claimants(rows, worker);
    if claimants.len() == 0 {
        return "no live session carries this address";
    }
    if claimants.len() > 1 {
        return (`${claimants.len()} live sessions claim this address; refusing to guess`);
    }
    let c = claimants[0];
    let id = lifecycle_text(c, "id");
    let named = if id == "" { "?" } else { id };
    // `reached` is three answers too: not published is not "silent", and a row that
    // never said must not read as one that did.
    let silent = doorbell_word(c);
    let ending = "";
    match c.get("outcome_at") {
        Some(n) => {
            if !lifecycle_null(n) {
                ending = `, ending record \`${n}\``;
            }
        }
        None => {
            if lifecycle_text(c, "last") == "errored" {
                let counted = lifecycle_number(c, "outcome_observed");
                if counted > 0 {
                    ending = `, no journal record for that ending; ${counted} unjournaled ending(s) counted on this registration instance`;
                } else {
                    ending = ", no journal record for that ending and no count published — an older writer's row, since this build counts every errored ending";
                }
            } else {
                ending = ", no ending record published";
            }
        }
    }
    `live as \`${named}\`${silent}: state \`${lifecycle_text(c, "state")}\`, last \`${lifecycle_text(c, "last")}\`${ending}`
}

// An epoch as a word. A null or absent epoch is **not** epoch 0: unknown is not zero, and
// a number-shaped zero would read as a real adoption epoch. The notice id's derivation
// still uses 0 for an absent epoch — an id is a key, not a claim about the world — but
// nothing printed here is allowed to make that substitution.
fn doorbell_word(row) {
    match row.get("reached") {
        Some(v) => {
            if lifecycle_null(v) {
                " (doorbell state not published)"
            } else if lifecycle_true(row.get("reached")) {
                ""
            } else {
                " (doorbell silent)"
            }
        }
        None => " (doorbell state not published)",
    }
}

fn start_rank_word(start) {
    let rank = lifecycle_text(start, "rank");
    let digest = lifecycle_text(start, "rank_digest");
    if rank == "" {
        return "no rank";
    }
    if digest == "" {
        return (`rank \`${rank}\`, no rank block (nothing appended)`);
    }
    return (`rank \`${rank}\`, block sha256 ${digest}`);
}

fn start_cancellation(start) {
    match start.get("cancellation") {
        Some(c) => {
            if lifecycle_null(c) {
                "none"
            } else {
                `${c}`
            }
        }
        None => "none",
    }
}

// The adoption epoch a start row is rendered with, and — in the same answer — where it came from.
//
// The ruling gives epochs to the plugin, so `custody_inspect`'s `adoption_epoch` is a field on
// its way out of core. Once it is gone, the log's silence is **not** "no epoch": the epoch is
// this ledger's, from the row that recorded it, and saying otherwise would present a ledger fact
// as a log fact. Four answers, in the order they are trusted:
//   the log's own field, when the log states one
//   this start row's own `adoption_epoch` — this ledger's record of the start
//   this ledger's live adoption row for the session the log (or the start row) named
//   neither: "not stated", which is not epoch 0
fn start_epoch_and_source(start, view, readable, adoptions) {
    if lifecycle_stated(view, "adoption_epoch") {
        return #{ "word": lifecycle_epoch_word(view, "adoption_epoch"), "source": "the log's answer, not current liveness" };
    }
    if lifecycle_stated(start, "adoption_epoch") {
        return #{ "word": lifecycle_epoch_word(start, "adoption_epoch"), "source": "this ledger's own start row, not the log; not current liveness" };
    }
    // Which worker this row is about: the log's typed `session` when it answered, else the row's.
    let session = lifecycle_text(view, "session");
    if session == "" {
        session = lifecycle_text(start, "session");
    }
    match lifecycle_find_adoption(adoptions, session) {
        Some(r) => {
            if lifecycle_stated(r, "epoch") {
                let why = if readable { "the log states no adoption epoch" } else { "the log does not answer for this operation" };
                return #{ "word": lifecycle_epoch_word(r, "epoch"), "source": `derived from this ledger's adoption row for \`${session}\`, because ${why}; not current liveness` };
            }
        }
        None => {}
    }
    #{ "word": "not stated", "source": "neither the log nor this ledger states an adoption epoch" }
}

// ---- the store, the roster, and the pure policy this tool repeats ----------
//
// Upstream compiles every `tools/*.rn` on its own and compiles `lib/` only in front
// of workflows, so the policy cannot be imported here. Everything from
// `lifecycle_store_empty` down is a byte-for-byte copy of `../lib/lifecycle.rn`;
// `tests/coordinator/lifecycle-drift.sh` fails if the two ever disagree.

async fn load_store() {
    let raw = eidolon::plugin_state_read(#{ "key": "store" }).await?;
    let reply = json::from_string(raw)?;
    let revision = lifecycle_number(reply, "revision");
    let store = lifecycle_store_empty();
    match reply.get("value") {
        Some(v) => {
            if lifecycle_null(v) {
                // Nothing written yet. `revision: 0, value: null` is the fact a first write
                // compares against, not a corrupt row — and a *fresh* ledger is the ordinary
                // case for a session whose first act is an adoption. Reading it as corruption
                // refused every handler on a session that had not seeded a store first, which
                // is what every test did and why this was invisible.
            } else if v is String {
                let got = json::from_string(`${v}`)?;
                if got is Object {
                    store = got;
                } else {
                    return Err(`the \`store\` row is not the object this ledger writes (${v}); it is refused rather than repaired or overwritten`);
                }
            } else {
                return Err("the `store` row's value is not the JSON text this ledger writes; it is refused rather than repaired or overwritten");
            }
        }
        None => {}
    }
    for key in ["adoptions", "notices", "gaps"] {
        store = lifecycle_store_put(store, key, lifecycle_store_list(store, key)?);
    }
    Ok(#{ "store": store, "revision": revision })
}

// A list-valued key of its own. `starts` stays out of the ledger because nothing in
// the guarantee depends on it and it changes on a different rhythm; a key that holds
// what is not a list is refused rather than read as empty.
async fn load_list(key) {
    let raw = eidolon::plugin_state_read(#{ "key": key }).await?;
    let reply = json::from_string(raw)?;
    match reply.get("value") {
        Some(v) => {
            if v is String {
                let parsed = json::from_string(`${v}`)?;
                if parsed is Vec {
                    Ok(parsed)
                } else {
                    Err(`the \`${key}\` row is not a JSON array; it is refused rather than repaired or overwritten`)
                }
            } else {
                Ok([])
            }
        }
        None => Ok([]),
    }
}

// The roster as one list. `me` is published beside `sessions`, not necessarily in it,
// and this session's own row still carries a rank and a decoration, so it is added
// when the list does not already carry it.
fn roster_rows(roster) {
    let out = [];
    if roster is Vec {
        return roster;
    }
    if roster is Object {
        match roster.get("sessions") {
            Some(s) => {
                if s is Vec {
                    for row in s {
                        out.push(row);
                    }
                }
            }
            None => {}
        }
        match roster.get("me") {
            Some(me) => {
                if me is Object {
                    let session = lifecycle_text(me, "session");
                    let seen = false;
                    for row in out {
                        if lifecycle_text(row, "session") == session {
                            seen = true;
                            break;
                        }
                    }
                    if !seen {
                        out.push(me);
                    }
                }
            }
            None => {}
        }
    }
    return out;
}

fn claimants(rows, session) {
    let out = [];
    if session == "" {
        return out;
    }
    for row in rows {
        if row is Object && lifecycle_text(row, "session") == session {
            out.push(row);
        }
    }
    out
}

// --- generated: the policy copy, from coordinator/lib/lifecycle.rn ---
//
// Do not edit these: they are the library's text. `--write` emits them and
// `lifecycle-drift.sh` fails if they differ from it by one byte — the whole region
// is compared against what the generator produces, so renaming a copy does not
// exempt it. Edit `coordinator/lib/lifecycle.rn`, then run `--write`.
// stamp: sha256:39b70aec3d33bb24cc7b2420420da4a0b090cef27d71c3e72cba3cc8cefe0ba4

fn lifecycle_stated(row, key) {
    match row.get(key) {
        Some(v) => !lifecycle_null(v),
        None => false,
    }
}
fn lifecycle_epoch_word(row, key) {
    if !lifecycle_stated(row, key) {
        return "not stated";
    }
    `${lifecycle_number(row, key)}`
}
fn lifecycle_store_empty() {
    #{ "adoptions": [], "notices": [], "gaps": [] }
}
fn lifecycle_store_list(store, key) {
    match store.get(key) {
        None => Ok([]),
        Some(v) => {
            if v is Vec {
                Ok(v)
            } else {
                Err(`the store's \`${key}\` is not a list (${v}); it is refused rather than repaired or overwritten`)
            }
        }
    }
}
fn lifecycle_store_put(store, key, list) {
    store.insert(key, list);
    store
}
fn lifecycle_blind_notes(store) {
    match store.get("blind") {
        Some(b) => {
            if b is Object {
                let notes = [];
                match b.get("notes") {
                    Some(v) => {
                        if v is Vec {
                            notes = v;
                        }
                    }
                    None => {}
                }
                let uncertain = [];
                match b.get("uncertain") {
                    Some(v) => {
                        if v is Vec {
                            uncertain = v;
                        }
                    }
                    None => {}
                }
                return #{ "notes": notes, "uncertain": uncertain };
            }
        }
        None => {}
    }
    #{ "notes": [], "uncertain": [] }
}
fn lifecycle_live_adoptions(adoptions) {
    let out = [];
    for a in adoptions {
        if a is Object && !lifecycle_released(a) {
            out.push(a);
        }
    }
    out
}
fn lifecycle_find_adoption(adoptions, worker) {
    for a in lifecycle_live_adoptions(adoptions) {
        if lifecycle_text(a, "worker") == worker {
            return Some(a);
        }
    }
    None
}
fn lifecycle_text(row, key) {
    match row.get(key) {
        Some(v) => {
            if lifecycle_null(v) {
                ""
            } else {
                `${v}`
            }
        }
        None => "",
    }
}
fn lifecycle_true(v) {
    match v {
        Some(b) => {
            if lifecycle_null(b) {
                false
            } else if b is bool {
                b
            } else {
                `${b}` == "true"
            }
        }
        None => false,
    }
}
fn lifecycle_number(row, key) {
    match row.get(key) {
        Some(v) => {
            if lifecycle_null(v) {
                0
            } else if v is i64 || v is u64 {
                v
            } else {
                match `${v}`.parse::<i64>() {
                    Ok(n) => n,
                    Err(_) => 0,
                }
            }
        }
        None => 0,
    }
}
fn lifecycle_released(row) {
    if lifecycle_true(row.get("released")) {
        return true;
    }
    match row.get("released_at_ms") {
        Some(v) => !lifecycle_null(v),
        None => false,
    }
}
fn lifecycle_null(v) {
    if v is String && `${v}` == "" {
        return true;
    }
    match json::to_string(v) {
        Ok(s) => s == "null",
        Err(_) => false,
    }
}
