// `coordinator_hook_ready` — the `plugin_ready` lifecycle handler.
//
// The harness calls this when a session starts or resumes, and again whenever the
// plugin is (re)loaded. It rebuilds the watch list from this session's own durable
// store and reasserts each stored rank's presentation prefix on the live row of
// exactly the session it was assigned to. It is idempotent: a decoration that
// already says what the store says is not rewritten, a worker that is gone is
// reported as gone rather than as a failure, and a decoration another controller
// holds is a conflict to report, never to take over.
//
// The store is the plugin's own state, keyed by the running session's attribution:
// the ledger's one `store` key (the watch list, which is its `adoptions` list) and
// `ranks`, which stays a key of its own because nothing in the ledger's guarantee
// depends on it. What this scan could not see is written into the ledger too, under
// `blind`, because core stores a handler's `notes` nowhere.

pub fn manifest() {
    #{
        name: "coordinator_hook_ready",
        description: "Lifecycle handler for `plugin_ready`: load the ledger's watch list and the stored ranks, reconcile the live roster against them, reapply each stored rank's decoration to the session it was assigned to when that decoration is ours or absent, report a decoration held by another owner and a session that is gone, record what this scan could not see, and return the full watch list rebuilt from the store.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{},
        },
    }
}

pub async fn call(input) {
    let notes = [];
    let uncertain = [];

    let loaded = load_store().await?;
    let adoptions = lifecycle_store_list(loaded.store, "adoptions")?;
    let ranks = load("ranks").await?;
    let watch = lifecycle_watch(adoptions);

    // A roster this scan could not read is a blind scan, not a scan that saw nobody.
    // Every stored rank is left exactly as it stands — reasserting one from an empty
    // list would attach nothing and report nothing — and the failure is written down
    // so the reading tools can say what this scan could not see.
    let rows = [];
    match eidolon::swarm_call("roster", #{}).await {
        Ok(raw) => {
            rows = roster_rows(json::from_string(raw)?);
        }
        Err(e) => {
            uncertain.push(`the roster could not be read (${e}), so no stored rank was reasserted on this scan, and nothing it says is a claim about any worker's state`);
            return finish(watch, notes, uncertain).await;
        }
    }

    for assignment in ranks.rows {
        if !(assignment is Object) {
            notes.push("a rank row is not an object; nothing attached");
            continue;
        }
        let session = lifecycle_text(assignment, "session");
        let prefix = lifecycle_rank_prefix(assignment);
        if session == "" {
            notes.push("a rank row carries no session; nothing to decorate");
            continue;
        }
        if prefix == "" {
            notes.push(`${session}: rank \`${lifecycle_text(assignment, "rank")}\` has no known prefix; nothing attached`);
            continue;
        }
        let claimants = claimants(rows, session);
        if claimants.len() == 0 {
            notes.push(`${session}: assigned ${prefix}, but no live session carries this address; nothing attached, and the assignment is kept`);
            continue;
        }
        if claimants.len() > 1 {
            notes.push(`${session}: ${claimants.len()} live sessions claim this address; refusing to guess which one carries ${prefix}`);
            continue;
        }
        let row = claimants[0];
        let action = lifecycle_decoration_action(row.get("decoration"), prefix);
        if action == "conflict" {
            let owner = "";
            match row.get("decoration") {
                Some(d) => {
                    if d is Object {
                        owner = lifecycle_text(d, "controller");
                    }
                }
                None => {}
            }
            notes.push(`${session}: another controller (${owner}) already holds the decoration; not taking it over, so ${prefix} is not attached`);
            continue;
        }
        if action == "none" {
            continue;
        }
        match eidolon::swarm_call("decorate", #{ "text": prefix, "controller": "coordinator", "expected": session }).await {
            Ok(_) => notes.push(`${session}: decoration ${prefix} attached`),
            Err(e) => notes.push(`${session}: decoration refused: ${e}`),
        }
    }

    // A gone worker is reported once per adopted address, and stays watched: the
    // store, not this scan, says who was adopted. If the roster publishes no
    // durable address at all, say that once instead of one "gone" per worker.
    let addresses = false;
    for row in rows {
        if lifecycle_text(row, "session") != "" {
            addresses = true;
        }
    }
    if watch.len() > 0 && !addresses {
        notes.push("no row in the roster publishes a `session`: null means not established, not no-such-session, so the watch list is kept and every worker is reported in one place rather than as gone");
    } else {
        for worker in watch {
            if claimants(rows, worker).len() == 0 {
                notes.push(`${worker}: no live session carries this adopted address; it stays watched, which is not a failure`);
            }
        }
    }

    finish(watch, notes, uncertain).await
}

// Every return goes through here. The scan's own words are kept in the ledger
// because they are stored nowhere else — core reads a handler's reply for `watch` and
// `verdict` only — so a blind write that cannot land is a handler failure rather than
// a quiet omission. The same act is in `hook_peer.rn`, and the plan's §4.3 says why.
async fn finish(watch, notes, uncertain) {
    let wrote = store_blind(notes, uncertain).await?;
    if !lifecycle_true(wrote.get("ok")) {
        return Err(`this scan's own words were not written down (${lifecycle_text(wrote, "detail")}), so no reading tool could report what it could not see: nothing in the harness stores a handler's notes, and this handler will not appear to have seen everything`);
    }
    Ok(#{ "watch": watch, "notes": notes, "uncertain": uncertain })
}

// ---- the store, and the pure policy this handler repeats -------------------
//
// Upstream compiles every `tools/*.rn` on its own and compiles `lib/` only in front
// of workflows, so the policy cannot be imported here. Everything from
// `lifecycle_store_empty` down is a byte-for-byte copy of `../lib/lifecycle.rn`, which
// is the one place it is explained; `tests/coordinator/lifecycle-drift.sh` fails if
// the two ever disagree. `load` is here for `ranks`, which stays a key of its own:
// nothing in the ledger's guarantee depends on it, and it changes on a different
// rhythm. The three `store_*` helpers are this handler's own.

async fn load(key) {
    let raw = eidolon::plugin_state_read(#{ "key": key }).await?;
    let reply = json::from_string(raw)?;
    let revision = match reply.get("revision") {
        Some(v) => v,
        None => 0,
    };
    let rows = match reply.get("value") {
        Some(v) => {
            if v is String {
                let parsed = json::from_string(`${v}`)?;
                if parsed is Vec {
                    parsed
                } else {
                    return Err(`the \`${key}\` row is not a JSON array; it is refused rather than repaired or overwritten`);
                }
            } else {
                []
            }
        }
        None => [],
    };
    Ok(#{ "rows": rows, "revision": revision })
}

// The ledger, as it stands on disk: the one `store` key and the revision a write has
// to hand back. An absent key is a store with no rows, not a corrupt one; a key that
// holds something which is not this store's object is refused rather than repaired.
// `hook_peer.rn` carries the same two functions, with the reasoning.
async fn load_store() {
    let raw = eidolon::plugin_state_read(#{ "key": "store" }).await?;
    let reply = json::from_string(raw)?;
    let revision = lifecycle_number(reply, "revision");
    let store = lifecycle_store_empty();
    match reply.get("value") {
        Some(v) => {
            if lifecycle_null(v) {
                // Nothing written yet. `revision: 0, value: null` is the fact a first write
                // compares against, not a corrupt row — and a *fresh* ledger is the ordinary
                // case for a session whose first act is an adoption. Reading it as corruption
                // refused every handler on a session that had not seeded a store first, which
                // is what every test did and why this was invisible.
            } else if v is String {
                let got = json::from_string(`${v}`)?;
                if got is Object {
                    store = got;
                } else {
                    return Err(`the \`store\` row is not the object this ledger writes (${v}); it is refused rather than repaired or overwritten`);
                }
            } else {
                return Err("the `store` row's value is not the JSON text this ledger writes; it is refused rather than repaired or overwritten");
            }
        }
        None => {}
    }
    for key in ["adoptions", "notices", "gaps"] {
        store = lifecycle_store_put(store, key, lifecycle_store_list(store, key)?);
    }
    Ok(#{ "store": store, "revision": revision })
}

// One durable write of the whole store. See `hook_peer.rn`: a compare-and-set refusal
// is a fact (nothing was written and the store moved), and an answer that is neither
// yes nor no is `uncertain` and never dressed as a write.
async fn write_store(store, revision) {
    let text = json::to_string(store)?;
    match eidolon::plugin_state_write(#{ "key": "store", "value": text, "revision": revision }).await {
        Ok(raw) => {
            let check = json::from_string(eidolon::plugin_state_read(#{ "key": "store" }).await?)?;
            match check.get("value") {
                Some(v) => {
                    if v is String && `${v}` == text {
                        Ok(#{ "status": "written", "revision": lifecycle_number(check, "revision") })
                    } else {
                        Ok(#{ "status": "uncertain", "detail": "the read-back did not carry the bytes just written" })
                    }
                }
                None => Ok(#{ "status": "uncertain", "detail": "the read-back carried no value" }),
            }
        }
        Err(e) => {
            let check = match json::from_string(eidolon::plugin_state_read(#{ "key": "store" }).await?) {
                Ok(v) => v,
                Err(bad) => return Ok(#{ "status": "uncertain", "detail": `the write was refused (${e}) and the read-back would not parse (${bad})` }),
            };
            let same = false;
            match check.get("value") {
                Some(v) => {
                    if v is String && `${v}` == text {
                        same = true;
                    }
                }
                None => {}
            }
            if same {
                Ok(#{ "status": "uncertain", "detail": `the write answered an error (${e}) and the bytes are now at the path: it may have landed, and the next scan settles it from the store` })
            } else {
                Ok(#{ "status": "refused", "detail": `${e}` })
            }
        }
    }
}

// This scan's own words, into the ledger, in at most two attempts.
async fn store_blind(notes, uncertain) {
    let attempt = 0;
    let detail = "";
    while attempt < 2 {
        attempt += 1;
        let loaded = load_store().await?;
        let store = lifecycle_blind(loaded.store, notes, uncertain);
        let wrote = write_store(store, loaded.revision).await?;
        let status = lifecycle_text(wrote, "status");
        if status == "written" {
            return Ok(#{ "ok": true });
        }
        if status == "uncertain" {
            return Ok(#{ "ok": false, "detail": lifecycle_text(wrote, "detail") });
        }
        detail = lifecycle_text(wrote, "detail");
    }
    Ok(#{ "ok": false, "detail": detail })
}

fn roster_rows(roster) {
    let out = [];
    if roster is Vec {
        return roster;
    }
    if roster is Object {
        match roster.get("sessions") {
            Some(s) => {
                if s is Vec {
                    for row in s {
                        out.push(row);
                    }
                }
            }
            None => {}
        }
        // `me` is published beside the list, not necessarily in it. A rank on this
        // session is still a rank this handler owes, so the caller's own row is
        // added when the list does not already carry it.
        match roster.get("me") {
            Some(me) => {
                if me is Object {
                    let session = lifecycle_text(me, "session");
                    let seen = false;
                    for row in out {
                        if lifecycle_text(row, "session") == session {
                            seen = true;
                            break;
                        }
                    }
                    if !seen {
                        out.push(me);
                    }
                }
            }
            None => {}
        }
    }
    return out;
}
fn claimants(rows, session) {
    let out = [];
    for row in rows {
        if row is Object && lifecycle_text(row, "session") == session {
            out.push(row);
        }
    }
    out
}

// --- generated: the policy copy, from coordinator/lib/lifecycle.rn ---
//
// Do not edit these: they are the library's text. `--write` emits them and
// `lifecycle-drift.sh` fails if they differ from it by one byte — the whole region
// is compared against what the generator produces, so renaming a copy does not
// exempt it. Edit `coordinator/lib/lifecycle.rn`, then run `--write`.
// stamp: sha256:f3afa6f239fb2e6812b97d0654f3b1f1006e552e1d128fa3d09c9049e6854f24

fn lifecycle_stated(row, key) {
    match row.get(key) {
        Some(v) => !lifecycle_null(v),
        None => false,
    }
}
fn lifecycle_epoch_word(row, key) {
    if !lifecycle_stated(row, key) {
        return "not stated";
    }
    `${lifecycle_number(row, key)}`
}
fn lifecycle_store_empty() {
    #{ "adoptions": [], "notices": [], "gaps": [] }
}
fn lifecycle_store_list(store, key) {
    match store.get(key) {
        None => Ok([]),
        Some(v) => {
            if v is Vec {
                Ok(v)
            } else {
                Err(`the store's \`${key}\` is not a list (${v}); it is refused rather than repaired or overwritten`)
            }
        }
    }
}
fn lifecycle_store_put(store, key, list) {
    store.insert(key, list);
    store
}
fn lifecycle_live_adoptions(adoptions) {
    let out = [];
    for a in adoptions {
        if a is Object && !lifecycle_released(a) {
            out.push(a);
        }
    }
    out
}
fn lifecycle_watch(adoptions) {
    let out = [];
    for a in lifecycle_live_adoptions(adoptions) {
        let worker = lifecycle_text(a, "worker");
        if worker == "" {
            continue;
        }
        let seen = false;
        for w in out {
            if w == worker {
                seen = true;
                break;
            }
        }
        if !seen {
            out.push(worker);
        }
    }
    out
}
fn lifecycle_blind(store, notes, uncertain) {
    store.insert("blind", #{ "notes": notes, "uncertain": uncertain });
    store
}
fn lifecycle_decoration_action(decoration, prefix) {
    match decoration {
        Some(d) => {
            if !(d is Object) {
                return "decorate";
            }
            let owner = lifecycle_text(d, "controller");
            let text = lifecycle_text(d, "text");
            if owner != "coordinator" {
                return "conflict";
            }
            if text == prefix {
                return "none";
            }
            "decorate"
        }
        None => "decorate",
    }
}
fn lifecycle_rank_prefix(row) {
    let stored = lifecycle_text(row, "prefix");
    if stored != "" {
        return stored;
    }
    lifecycle_prefix_of(lifecycle_text(row, "rank"))
}
fn lifecycle_prefix_of(rank) {
    let w = rank.trim().to_lowercase();
    if w == "imperator" { return "Imperator"; }
    if w == "legatus" { return "Legatus"; }
    if w == "tribunus" { return "Tribunus"; }
    if w == "centurio" { return "Centurio"; }
    if w == "miles" { return "Miles"; }
    ""
}
fn lifecycle_payload(observation) {
    match observation.get("payload") {
        Some(p) => {
            if p is Object {
                p
            } else {
                #{}
            }
        }
        None => #{},
    }
}
fn lifecycle_text(row, key) {
    match row.get(key) {
        Some(v) => {
            if lifecycle_null(v) {
                ""
            } else {
                `${v}`
            }
        }
        None => "",
    }
}
fn lifecycle_true(v) {
    match v {
        Some(b) => {
            if lifecycle_null(b) {
                false
            } else if b is bool {
                b
            } else {
                `${b}` == "true"
            }
        }
        None => false,
    }
}
fn lifecycle_number(row, key) {
    match row.get(key) {
        Some(v) => {
            if lifecycle_null(v) {
                0
            } else if v is i64 || v is u64 {
                v
            } else {
                match `${v}`.parse::<i64>() {
                    Ok(n) => n,
                    Err(_) => 0,
                }
            }
        }
        None => 0,
    }
}
fn lifecycle_released(row) {
    if lifecycle_true(row.get("released")) {
        return true;
    }
    match row.get("released_at_ms") {
        Some(v) => !lifecycle_null(v),
        None => false,
    }
}
fn lifecycle_null(v) {
    if v is String && `${v}` == "" {
        return true;
    }
    match json::to_string(v) {
        Ok(s) => s == "null",
        Err(_) => false,
    }
}
