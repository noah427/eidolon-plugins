// `coordinator_notices`: the notices this session is owed, whether or not they
// reached it.
//
// A notice is written down before it is journaled, so a notice that never reached
// the conversation is a record here rather than a silence. "Journaled" is a fact
// about this session's own log and the record number is kept beside it; nothing in
// this answer claims the coordinator has *read* anything. The roster is not
// consulted at all — a notice's state does not depend on who is visible.

pub fn manifest() {
    #{
        name: "coordinator_notices",
        description: "Every notice owed to this session by the workers it adopted: which worker and which epoch, the halt it is about (state, last outcome, the occurrence token it was keyed on), whether it is still owed or journaled in this session's own log as which record, and what became of it. A notice the ledger still holds open is shown as open — nothing is dropped for being unjournaled, and nothing claims a delivery the log did not record.",
        approval: "read_only",
        input_schema: #{
            "type": "object",
            "properties": #{},
        },
    }
}

pub async fn call(input) {
    let loaded = load_store().await?;
    let store = loaded.store;
    let notices = lifecycle_store_list(store, "notices")?;
    if notices.len() == 0 {
        return Ok("no notices are owed to this session.\n");
    }
    let out = "";
    let imported = false;
    for row in notices {
        if !(row is Object) {
            out += "a notice row is not an object; it is shown as it stands and cannot be read\n";
            continue;
        }
        let worker = lifecycle_text(row, "worker");
        let name = lifecycle_text(row, "name");
        let who = if name == "" { worker } else { `${name} (${worker})` };
        out += `${lifecycle_text(row, "notice_id")} — ${who} (epoch ${lifecycle_epoch_word(row, "epoch")}): state \`${lifecycle_text(row, "state")}\`, last \`${lifecycle_text(row, "last")}\`, occurrence \`${lifecycle_text(row, "occurrence")}\`\n`;
        if lifecycle_text(row, "key_kind") == "observed" {
            out += "  (an ending the journal never saw: keyed on that registration instance's own count)\n";
        }
        out += `  outcome: ${outcome_word(row, store)?}\n`;
        out += `  ${lifecycle_text(row, "text")}\n`;
        if !imported_outcome(row) {
            // nothing to add
        } else {
            imported = true;
        }
    }
    out += "\nNothing here is a claim about who is visible: the ledger is this plugin's own store, and a notice's state does not depend on the roster.\n";
    out += "`journaled` means the record is in this session's own log. The harness journals it at a safe point and the wake that may follow is not evidence of anything, so this plugin keeps no attempt count and no transport's words: there is no transport. A journaled notice is not a notice the coordinator has read.\n";
    if imported {
        out += "A row whose outcome is `delivered`, `queued`, `partial`, `failed` or `refused` is the retired monitor's own record, carried over verbatim and marked as the service recorded it; the time beside it is the service's clock, which this plugin does not have.\n";
    }
    Ok(out)
}

// What became of one notice, in the ledger's own words rather than the transport's.
// The distinction the service drew between "not sent" and "sent but unconfirmed"
// survives; the second half of it does not, because there is no longer a transport
// that can half-succeed.
fn outcome_word(row, store) {
    let word = lifecycle_text(row, "outcome");
    let record = lifecycle_number(row, "record");
    if word == "written" {
        let raw = match row.get("record") {
            Some(v) => v,
            None => json::from_string("null")?,
        };
        if lifecycle_null(raw) {
            return Ok("journaled — the log named a record this row did not keep, so the record number is not stated here");
        }
        return Ok(`journaled — record ${record} in this session's own log`);
    }
    if word == "cancelled" {
        return Ok("cancelled — the epoch was released before this row was closed as journaled. This ledger never journaled it on purpose; a journal call that landed without its mark would not be visible here, and the log is the only record of that");
    }
    if word == "pending" {
        if !lifecycle_stated(row, "epoch") {
            return Ok("owed, and the row states no epoch — it cannot be matched to an adoption, so it stays pending rather than being cancelled");
        }
        let live = lifecycle_epoch_live(store, lifecycle_text(row, "worker"), lifecycle_number(row, "epoch"))?;
        if live {
            return Ok("owed, not yet journaled");
        }
        return Ok("still open, and its epoch was released — the next scan marks it cancelled. Whether it reached the log already is not something this row can say: a journal call that landed without its mark reads exactly like this");
    }
    if imported_outcome(row) {
        let at = lifecycle_text(row, "answered_at_ms");
        if at == "" {
            return Ok(`${word} as the service recorded it`);
        }
        return Ok(`${word} as the service recorded it, answered at ${at}`);
    }
    Ok(`\`${word}\`: not a word this ledger writes, shown as it stands`);
}

fn imported_outcome(row) {
    let word = lifecycle_text(row, "outcome");
    word == "delivered" || word == "queued" || word == "partial" || word == "failed" || word == "refused"
}

// ---- the store, and the pure policy this tool repeats ----------------------
//
// Upstream compiles every `tools/*.rn` on its own and compiles `lib/` only in front
// of workflows, so the policy cannot be imported here. Everything below is a
// byte-for-byte copy of `../lib/lifecycle.rn`; `tests/coordinator/lifecycle-drift.sh`
// fails if the two ever disagree. This tool reads the ledger and writes nothing.

async fn load_store() {
    let raw = eidolon::plugin_state_read(#{ "key": "store" }).await?;
    let reply = json::from_string(raw)?;
    let revision = lifecycle_number(reply, "revision");
    let store = lifecycle_store_empty();
    match reply.get("value") {
        Some(v) => {
            if lifecycle_null(v) {
                // Nothing written yet. `revision: 0, value: null` is the fact a first write
                // compares against, not a corrupt row — and a *fresh* ledger is the ordinary
                // case for a session whose first act is an adoption. Reading it as corruption
                // refused every handler on a session that had not seeded a store first, which
                // is what every test did and why this was invisible.
            } else if v is String {
                let got = json::from_string(`${v}`)?;
                if got is Object {
                    store = got;
                } else {
                    return Err(`the \`store\` row is not the object this ledger writes (${v}); it is refused rather than repaired or overwritten`);
                }
            } else {
                return Err("the `store` row's value is not the JSON text this ledger writes; it is refused rather than repaired or overwritten");
            }
        }
        None => {}
    }
    for key in ["adoptions", "notices", "gaps"] {
        store = lifecycle_store_put(store, key, lifecycle_store_list(store, key)?);
    }
    Ok(#{ "store": store, "revision": revision })
}

// --- generated: the policy copy, from coordinator/lib/lifecycle.rn ---
//
// Do not edit these: they are the library's text. `--write` emits them and
// `lifecycle-drift.sh` fails if they differ from it by one byte — the whole region
// is compared against what the generator produces, so renaming a copy does not
// exempt it. Edit `coordinator/lib/lifecycle.rn`, then run `--write`.
// stamp: sha256:f3afa6f239fb2e6812b97d0654f3b1f1006e552e1d128fa3d09c9049e6854f24

fn lifecycle_true(v) {
    match v {
        Some(b) => {
            if lifecycle_null(b) {
                false
            } else if b is bool {
                b
            } else {
                `${b}` == "true"
            }
        }
        None => false,
    }
}
fn lifecycle_stated(row, key) {
    match row.get(key) {
        Some(v) => !lifecycle_null(v),
        None => false,
    }
}
fn lifecycle_epoch_word(row, key) {
    if !lifecycle_stated(row, key) {
        return "not stated";
    }
    `${lifecycle_number(row, key)}`
}
fn lifecycle_store_empty() {
    #{ "adoptions": [], "notices": [], "gaps": [] }
}
fn lifecycle_store_list(store, key) {
    match store.get(key) {
        None => Ok([]),
        Some(v) => {
            if v is Vec {
                Ok(v)
            } else {
                Err(`the store's \`${key}\` is not a list (${v}); it is refused rather than repaired or overwritten`)
            }
        }
    }
}
fn lifecycle_store_put(store, key, list) {
    store.insert(key, list);
    store
}
fn lifecycle_live_adoptions(adoptions) {
    let out = [];
    for a in adoptions {
        if a is Object && !lifecycle_released(a) {
            out.push(a);
        }
    }
    out
}
fn lifecycle_epoch_live(store, worker, epoch) {
    let adoptions = lifecycle_store_list(store, "adoptions")?;
    for a in lifecycle_live_adoptions(adoptions) {
        // An adoption that states no epoch cannot be the adoption this epoch belongs to:
        // matching it would be matching a fabricated 0 against a fabricated 0.
        if !lifecycle_stated(a, "epoch") {
            continue;
        }
        if lifecycle_text(a, "worker") == worker && lifecycle_number(a, "epoch") == epoch {
            return Ok(true);
        }
    }
    Ok(false)
}
fn lifecycle_text(row, key) {
    match row.get(key) {
        Some(v) => {
            if lifecycle_null(v) {
                ""
            } else {
                `${v}`
            }
        }
        None => "",
    }
}
fn lifecycle_number(row, key) {
    match row.get(key) {
        Some(v) => {
            if lifecycle_null(v) {
                0
            } else if v is i64 || v is u64 {
                v
            } else {
                match `${v}`.parse::<i64>() {
                    Ok(n) => n,
                    Err(_) => 0,
                }
            }
        }
        None => 0,
    }
}
fn lifecycle_released(row) {
    if lifecycle_true(row.get("released")) {
        return true;
    }
    match row.get("released_at_ms") {
        Some(v) => !lifecycle_null(v),
        None => false,
    }
}
fn lifecycle_null(v) {
    if v is String && `${v}` == "" {
        return true;
    }
    match json::to_string(v) {
        Ok(s) => s == "null",
        Err(_) => false,
    }
}
