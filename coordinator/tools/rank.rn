// `coordinator_rank`: give a session a rank, as **a tag the session itself carries**.
//
// There is no ledger behind this and no service in front of it. The word becomes
// `rank:<word>` among the ranked session's own tags — stored by the harness, shown on
// its roster row, and durable because the harness keeps a session's authored tags
// beside the session's log — while the session's own label and every tag this plugin
// did not name are left exactly as they stand.
//
// The replacement is a **family** replacement, not a remove-and-add: every tag
// beginning `rank:` goes and the new one arrives in the same act, so two coordinators
// assigning at once leave one rank standing rather than two. That is why the call
// carries a prefix at all, and it is the one place this tool's vocabulary reaches the
// harness — as a literal string the harness matches and attaches no meaning to.
//
// It is presentation and nothing else: no permission, no role, no adoption, no
// reporting line, and no reader may take it for any of those. What the words are is
// this plugin's own convention (`ranks/`); the harness has no rank enum, no rank
// journal record and no rank flag.
//
// The assigning side is not an argument, and it is not recorded: a rank is a tag on
// the session it belongs to, the act is performed by that session's own process over
// its own door, and a tag has no owner to name. A session with **no live registration
// is refused** with that reason rather than queued: a tag belongs to a registration,
// and durability across a resume is the record beside the log — not a pending
// assignment for a process that is not there.
pub fn manifest() {
    #{
        name: "coordinator_rank",
        description: "Give a session a rank: `rank:<word>` joins that session's own tags, replacing any rank tag it already carried and leaving its label and every other tag untouched. Presentation only — no permission, no role, no adoption, nothing the harness reads back. The tag is durable and survives the session's resume. A session with no live registration is refused, because a tag belongs to a registration.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "session": #{
                    "type": "string",
                    "description": "The session's durable address, exactly as `eidolon peers` prints it. Echoed verbatim; never a display name, a label or a registration id.",
                },
                "rank": #{
                    "type": "string",
                    "description": "The word: imperator, legatus, tribunus, centurio or miles.",
                    "enum": ["imperator", "legatus", "tribunus", "centurio", "miles"],
                },
            },
            "required": ["session", "rank"],
        },
    }
}

pub async fn call(input) {
    let session = match text_of(input.get("session")) {
        Some(s) => s,
        None => return Err("coordinator_rank needs `session`: the session's durable address, exactly as `eidolon peers` prints it — never a display name"),
    };
    match refuse_control_chars("session", session) {
        Some(e) => return Err(e),
        None => {}
    }
    let rank = match text_of(input.get("rank")) {
        Some(s) => s,
        None => return Err("coordinator_rank needs `rank`: one of imperator, legatus, tribunus, centurio, miles"),
    };
    match refuse_control_chars("rank", rank) {
        Some(e) => return Err(e),
        None => {}
    }
    // Lowercased because a tag is one word and the convention spells it lower; the
    // *vocabulary* is not widened by an argument, so an unknown word is refused rather
    // than stored as a tag nobody reads.
    let word = rank.trim().to_lowercase();
    if !is_rank(word) {
        return Err(`\`${rank}\` is not one of this plugin's ranks: imperator, legatus, tribunus, centurio, miles. The vocabulary lives in this plugin (\`ranks/\`) and an argument does not add to it`);
    }
    let said = match eidolon::swarm_call("tag", #{
        "session": session,
        "set": `rank:${word}`,
        "remove_prefix": "rank:",
    })
        .await
    {
        Ok(v) => `${v}`,
        Err(e) => return Err(`the rank was not set: ${e}`),
    };
    `${said}. The session's own label and every tag outside \`rank:\` are untouched; a reader of \`eidolon peers\` sees the tag, not a decoration, and it outlives a resume`
}

// One of the five words this plugin ships a block for. Not a harness enum: the harness
// stores whatever tag it is given, and this list is the plugin's own convention.
fn is_rank(word) {
    if word == "imperator" {
        return true;
    }
    if word == "legatus" {
        return true;
    }
    if word == "tribunus" {
        return true;
    }
    if word == "centurio" {
        return true;
    }
    if word == "miles" {
        return true;
    }
    false
}

// Everything below is the same in every coordinator_*.rn: upstream eidolon compiles each
// tool file on its own, so a tool file is handed over whole.

fn text_of(v) {
    match v {
        Some(x) => {
            let s = `${x}`;
            // A JSON null arrives as the unit value, whose text form is `null`.
            if s == "null" || s == "" {
                None
            } else {
                Some(s)
            }
        }
        None => None,
    }
}

// A newline in an address would forge a roster row or split a notice; a NUL or a tab is
// not a thing an address has. Refused before anything is sent.
fn refuse_control_chars(field, s) {
    if s.contains("\n") {
        return Some(`${field} contains a newline, which would forge a row rather than name a session`);
    }
    if s.contains("\r") {
        return Some(`${field} contains a carriage return`);
    }
    if s.contains("\t") {
        return Some(`${field} contains a tab`);
    }
    None
}
