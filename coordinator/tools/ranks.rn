// `coordinator_ranks`: the ranks that stand right now, read off the sessions that carry
// them.
//
// There is no record to print beside the screen any more: a rank **is** a tag on the
// session it belongs to, so this reads the roster and lists the rows whose tags include
// `rank:<word>`. What that buys is that there is nothing to disagree with — no store
// that says one thing while a registration says another, no "assigned but not attached"
// state, and no reassertion when a session resumes, because the tag is already the
// session's own.
//
// What it does not show, and says so: a session with no live registration has no row
// here. A rank survives a resume, so it will be back when the session is; it is not
// missing in the meantime, it is simply not a fact about the roster at this instant.
pub fn manifest() {
    #{
        name: "coordinator_ranks",
        description: "List the ranks that stand now: every live session whose own tags carry `rank:<word>`, with the label it publishes. Read-only, and the tags are the only source — this plugin keeps no rank record of its own, so there is nothing that can disagree with a registration. A session that is not registered right now has no row; its rank survives and reappears when it resumes.",
        approval: "read_only",
        input_schema: #{
            "type": "object",
            "properties": #{},
        },
    }
}

pub async fn call(input) {
    let raw = match eidolon::swarm_call("roster", #{}).await {
        Ok(v) => v,
        Err(e) => return Err(`the roster could not be read (${e}), so nothing here is a claim about any session's rank`),
    };
    let parsed = match json::from_string(raw) {
        Ok(v) => v,
        Err(e) => return Err(`the roster answered something that is not JSON (${e}; \`swarm_call("roster")\` said: ${raw})`),
    };
    let rows = roster_rows(parsed);

    let out = "";
    let ranked = 0;
    let unaddressable = 0;
    for row in rows {
        if !(row is Object) {
            continue;
        }
        let session = text(row, "session");
        if session == "" {
            unaddressable += 1;
            continue;
        }
        let rank = rank_of(row);
        if rank == "" {
            continue;
        }
        ranked += 1;
        let name = text(row, "display");
        if name == "" {
            out += `${session} — ${rank}\n`;
        } else {
            out += `${session} (${name}) — ${rank}\n`;
        }
    }

    if ranked == 0 {
        out += "no live session carries a `rank:` tag: a rank is a tag on a registration, so there is nothing to show while nobody is ranked\n";
    } else {
        out += `\n${ranked} ranked live session(s). A rank is that session's own tag: it is presentation, not authority, not an adoption, and not a reporting line.`;
        out += " A session that is not registered right now has no row here; its rank survives its resume and reappears with it.\n";
    }
    if unaddressable > 0 {
        out += `${unaddressable} live row(s) publish no \`session\` id, so no rank could be attributed to an address: null means not established, not no-such-session.\n`;
    }
    Ok(out)
}

fn roster_rows(roster) {
    let out = [];
    if roster is Vec {
        return roster;
    }
    if roster is Object {
        match roster.get("sessions") {
            Some(s) => {
                if s is Vec {
                    for row in s {
                        out.push(row);
                    }
                }
            }
            None => {}
        }
        match roster.get("me") {
            Some(me) => {
                if me is Object {
                    out.push(me);
                }
            }
            None => {}
        }
    }
    out
}

// The rank tag a row presents, or the empty string. Read off the row's presented tags:
// the authored set is what the session published, and the harness's derived tags
// (`persona:`, `model:`, `provider:`) cannot begin with this prefix.
fn rank_of(row) {
    for tag in tags_of(row) {
        let t = `${tag}`;
        if t.starts_with("rank:") {
            return t;
        }
    }
    ""
}

fn tags_of(row) {
    let out = [];
    match row.get("tags") {
        Some(t) => {
            if t is Vec {
                for tag in t {
                    out.push(tag);
                }
            }
        }
        None => {}
    }
    out
}

// A string field, or the empty string. A JSON `null` arrives as the unit value, which has no
// display form at all — interpolating it raised `Missing protocol function DISPLAY_FMT for Tuple`,
// so the type is checked before the text is made rather than after.
fn text(row, key) {
    match row.get(key) {
        Some(s) => {
            if s is String {
                `${s}`
            } else {
                ""
            }
        }
        None => "",
    }
}
