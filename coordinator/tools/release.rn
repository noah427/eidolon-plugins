// `coordinator_release`: end monitoring of one adopted worker — in **this plugin's ledger**.
//
// Release-of-monitoring is coordination domain (operator ruling 2026-10-29), so there is no core
// verb to call and none is called: `custody_release` is leaving core, and a release here is a
// durable fact in `plugin_state`, not a harness act. Nothing is killed and no pipe is touched.
//
// Three things, in the order the guarantee needs (`reports/…/verb-contracts.md` § release,
// `lifecycle.rn` §2.1):
//   1. the row is marked released **durably first** — "the release was not written down, so it did
//      not happen" — and an uncertain write claims nothing;
//   2. the epoch's **pending** notices become `cancelled` in the *same* compare-and-set, because
//      the ledger is one key and that is what makes clause 1 of the guarantee atomic: once this
//      release is durable, no notice of that epoch is ever handed to the transport;
//   3. a notice already **journaled** is not retracted — a release cannot unwrite what a
//      coordinator has read — and the record stays with its reason.
//
// One refusal in front of all three: a worker whose cancellation has not been observed exiting
// is not released. That word is on this ledger's row (`cancellation: attempted`, written by
// `coordinator_cancel` from the log's typed outcome), and the guard is the retired service's own
// (`service/src/lib.rs:1067`) kept at the owner the ruling gives it.
//
// No clock: this plugin has none, so the tombstone is the word `released` and the reason, never a
// time nobody measured.

pub fn manifest() {
    #{
        name: "coordinator_release",
        description: "End monitoring of one adopted worker. The record stays, with the reason, and re-adopting the same worker later is a new epoch. Pending notices of that epoch are cancelled in the same durable write and will never be sent; a notice already journaled in the conversation is not retracted. Nothing is killed and no pipe is touched.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "session": #{
                    "type": "string",
                    "description": "The worker's durable address, exactly as it was adopted.",
                },
                "reason": #{
                    "type": "string",
                    "description": "Why monitoring ends. Kept with the record; it is not a status.",
                },
            },
            "required": ["session"],
        },
    }
}

pub async fn call(input) {
    let worker = match text_of(input.get("session")) {
        Some(s) => s,
        None => return Err("coordinator_release needs `session`: the worker's durable address, exactly as it was adopted"),
    };
    match refuse_control_chars("session", worker) {
        Some(e) => return Err(e),
        None => {}
    }
    let reason = match text_of(input.get("reason")) {
        Some(s) => s,
        None => "",
    };

    let attempt = 0;
    let refusal = "";
    while attempt < 2 {
        attempt += 1;
        let loaded = load_store().await?;
        let store = loaded.store;
        let adoptions = store_list(store, "adoptions");

        let row = #{};
        let live = false;
        for a in adoptions {
            if a is Object && ledger_text(a, "worker") == worker && !ledger_released(a) {
                row = a;
                live = true;
                break;
            }
        }
        if !live {
            return Err(`${worker} is not adopted by this session (or was already released); there is nothing to release`);
        }

        // A cancellation whose exit was never observed keeps supervision here, so a release of it
        // is refused until an exit is observed. **This is the retired service's own guard**
        // (`service/src/lib.rs:1067`), preserved at the owner the ruling gives it — not a new
        // policy: the service refused while its start record still held
        // `CancelOutcome::Attempted` for this worker and epoch. The word is core's, recorded on
        // this row by `coordinator_cancel` from the log's typed `cancellation` field; releasing
        // over it would announce the end of supervision for a child nobody saw exit.
        if ledger_text(row, "cancellation") == "attempted" {
            return Err(`the exit of ${worker} was never observed: \`coordinator_cancel\` recorded a durable cancellation intent (operation \`${ledger_text(row, "cancel_operation")}\`, and the log's outcome word was \`attempted\`), so supervision is retained and a release would end it over an unobserved exit. Retry \`coordinator_cancel\` with the same reason to re-ask the OS half and re-read the log; when it answers \`exited\` this row is marked and the release goes through`);
        }

        // The epoch this release closes, if the row states one. An unstated epoch is not epoch 0:
        // the notices it may cancel are the ones whose epoch is *also* unstated, and any other
        // pending row is left alone and counted.
        let stated = ledger_stated(row, "epoch");
        let epoch = ledger_number(row, "epoch");
        row.insert("released", true);
        row.insert("release_reason", reason);

        let notices = store_list(store, "notices");
        let cancelled = 0;
        let left = 0;
        for n in notices {
            if !(n is Object) {
                continue;
            }
            if ledger_text(n, "worker") != worker || ledger_text(n, "outcome") != "pending" {
                continue;
            }
            let same = ledger_stated(n, "epoch") == stated;
            if same && (!stated || ledger_number(n, "epoch") == epoch) {
                n.insert("outcome", "cancelled");
                cancelled += 1;
            } else {
                left += 1;
            }
        }

        let wrote = write_store(store_put(store, "notices", notices), loaded.revision).await?;
        let status = ledger_text(wrote, "status");
        if status == "written" {
            return Ok(`released ${worker} (epoch ${lifecycle_epoch_word(row, "epoch")}); monitoring ends now. ${cancelled} pending notice(s) of that epoch were cancelled in the same write and will never be sent. A notice already journaled is not retracted, and the record stays with its reason${left_word(left)}.`);
        }
        if status == "uncertain" {
            return Ok(`the release of ${worker} **may or may not be written down**: the write came back uncertain (${ledger_text(wrote, "detail")}). Nothing is claimed — retry, and a release this ledger did write is found by the retry (it will answer that the worker is already released rather than releasing twice).`);
        }
        refusal = ledger_text(wrote, "detail");
    }
    Err(`the release of ${worker} was **not written down**, so it did not happen (${refusal})`)
}

fn left_word(left) {
    if left == 0 {
        return "";
    }
    ` ${left} pending notice(s) were left alone because their epoch could not be matched to this adoption, and an unmatched epoch is not a reason to cancel one`;
}

fn text_of(v) {
    match v {
        Some(x) => {
            if x is String {
                let s = `${x}`;
                if s == "null" {
                    None
                } else {
                    Some(s)
                }
            } else {
                None
            }
        }
        None => None,
    }
}

fn refuse_control_chars(field, s) {
    for c in s.chars() {
        let n = `${c}`;
        if n == "\\n" || n == "\\r" || n == "\\t" {
            return Some(`\`${field}\` carries a control character; an address is one word, and a line break in it would be a forged line wherever it is printed`);
        }
    }
    None
}

// ---- the ledger, and the pure policy this tool repeats ---------------------
//
// Upstream compiles every `tools/*.rn` on its own and compiles `lib/` only in front of
// workflows, so the policy cannot be imported here. Everything from `lifecycle_stated` down is the
// library's text, emitted by `tests/coordinator/lifecycle-copies.py --write`; `lifecycle-drift.sh`
// fails if it drifts.

async fn load_store() {
    let raw = eidolon::plugin_state_read(#{ "key": "store" }).await?;
    let reply = json::from_string(raw)?;
    let revision = lifecycle_number(reply, "revision");
    let store = lifecycle_store_empty();
    match reply.get("value") {
        Some(v) => {
            if lifecycle_null(v) {
                // Nothing written yet: `revision: 0, value: null` is the fact a first write compares
                // against, not a corrupt row.
            } else if v is String {
                let got = json::from_string(`${v}`)?;
                if got is Object {
                    store = got;
                } else {
                    return Err(`the \`store\` row is not the object this ledger writes (${v}); it is refused rather than repaired or overwritten`);
                }
            } else {
                return Err("the `store` row's value is not the JSON text this ledger writes; it is refused rather than repaired or overwritten");
            }
        }
        None => {}
    }
    for key in ["adoptions", "notices", "gaps"] {
        store = lifecycle_store_put(store, key, lifecycle_store_list(store, key)?);
    }
    Ok(#{ "store": store, "revision": revision })
}

async fn write_store(store, revision) {
    let text = json::to_string(store)?;
    match eidolon::plugin_state_write(#{ "key": "store", "value": text, "revision": revision }).await {
        Ok(_) => {
            let check = json::from_string(eidolon::plugin_state_read(#{ "key": "store" }).await?)?;
            match check.get("value") {
                Some(v) => {
                    if v is String && `${v}` == text {
                        Ok(#{ "status": "written", "revision": lifecycle_number(check, "revision") })
                    } else {
                        Ok(#{ "status": "uncertain", "detail": "the read-back did not carry the bytes just written" })
                    }
                }
                None => Ok(#{ "status": "uncertain", "detail": "the read-back carried no value" }),
            }
        }
        Err(e) => {
            let check = match json::from_string(eidolon::plugin_state_read(#{ "key": "store" }).await?) {
                Ok(v) => v,
                Err(bad) => return Ok(#{ "status": "uncertain", "detail": `the write was refused (${e}) and the read-back would not parse (${bad})` }),
            };
            let same = false;
            match check.get("value") {
                Some(v) => {
                    if v is String && `${v}` == text {
                        same = true;
                    }
                }
                None => {}
            }
            if same {
                Ok(#{ "status": "uncertain", "detail": `the write answered an error (${e}) and the bytes are now at the path: it may have landed` })
            } else {
                Ok(#{ "status": "refused", "detail": `${e}` })
            }
        }
    }
}

fn ledger_text(row, key) {
    lifecycle_text(row, key)
}

fn ledger_number(row, key) {
    lifecycle_number(row, key)
}

fn ledger_released(row) {
    lifecycle_released(row)
}

fn ledger_stated(row, key) {
    lifecycle_stated(row, key)
}

fn store_list(store, key) {
    lifecycle_store_list(store, key)?
}

fn store_put(store, key, list) {
    lifecycle_store_put(store, key, list)
}
// --- generated: the policy copy, from coordinator/lib/lifecycle.rn ---
//
// Do not edit these: they are the library's text. `--write` emits them and
// `lifecycle-drift.sh` fails if they differ from it by one byte — the whole region
// is compared against what the generator produces, so renaming a copy does not
// exempt it. Edit `coordinator/lib/lifecycle.rn`, then run `--write`.
// stamp: sha256:5571f456e964c4ae3b661519ec5789d9b85a04df6ff9d7f6c40fb2540d806aa0

fn lifecycle_stated(row, key) {
    match row.get(key) {
        Some(v) => !lifecycle_null(v),
        None => false,
    }
}
fn lifecycle_epoch_word(row, key) {
    if !lifecycle_stated(row, key) {
        return "not stated";
    }
    `${lifecycle_number(row, key)}`
}
fn lifecycle_store_empty() {
    #{ "adoptions": [], "notices": [], "gaps": [] }
}
fn lifecycle_store_list(store, key) {
    match store.get(key) {
        None => Ok([]),
        Some(v) => {
            if v is Vec {
                Ok(v)
            } else {
                Err(`the store's \`${key}\` is not a list (${v}); it is refused rather than repaired or overwritten`)
            }
        }
    }
}
fn lifecycle_store_put(store, key, list) {
    store.insert(key, list);
    store
}
fn lifecycle_text(row, key) {
    match row.get(key) {
        Some(v) => {
            if lifecycle_null(v) {
                ""
            } else {
                `${v}`
            }
        }
        None => "",
    }
}
fn lifecycle_number(row, key) {
    match row.get(key) {
        Some(v) => {
            if lifecycle_null(v) {
                0
            } else if v is i64 || v is u64 {
                v
            } else {
                match `${v}`.parse::<i64>() {
                    Ok(n) => n,
                    Err(_) => 0,
                }
            }
        }
        None => 0,
    }
}
fn lifecycle_true(v) {
    match v {
        Some(b) => {
            if lifecycle_null(b) {
                false
            } else if b is bool {
                b
            } else {
                `${b}` == "true"
            }
        }
        None => false,
    }
}
fn lifecycle_released(row) {
    if lifecycle_true(row.get("released")) {
        return true;
    }
    match row.get("released_at_ms") {
        Some(v) => !lifecycle_null(v),
        None => false,
    }
}
fn lifecycle_null(v) {
    if v is String && `${v}` == "" {
        return true;
    }
    match json::to_string(v) {
        Ok(s) => s == "null",
        Err(_) => false,
    }
}
