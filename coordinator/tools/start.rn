// One dispatcher-admitted managed start: the caller is derived from the harness,
// never an input. The service's token is transport auth, as for adopt; it is not
// a new authority grant. Start/retry always re-enters this registry tool's gate.
pub fn manifest() {
    #{
        name: "coordinator_start",
        description: "Start and adopt one managed worker as one operation. The harness holds the child before its first model turn; adoption is made durable before release. Name an operation id and retry ONLY the same immutable input to reconcile. A partial/ambiguous outcome is not success and never causes a blind replacement or brief resend. The child currently uses persistent headless chat; desktop/persona enforcement is not implied. Model/spend/workspace permissions are decided by this call's dispatcher, not by rank. A transport-accepted brief is not proof it was consumed or executed.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "additionalProperties": false,
            "properties": #{
                "operation": #{ "type": "string", "description": "Idempotency key for this exact start request, not a session address." },
                "workspace": #{ "type": "string", "description": "Existing working directory for the child; no worktree is created." },
                "model": #{ "type": "string", "description": "Explicit provider:model key; this may spend within the admitted scope." },
                "persona": #{ "type": "string", "description": "Optional requested persona; not an authority grant or verified visibility claim." },
                "brief": #{ "type": "string", "description": "Bounded assignment delivered as one peer message after durable supervision." },
            },
            "required": ["operation", "workspace", "model", "brief"],
        },
    }
}

pub async fn call(input) {
    let caller = my_address().await?;
    let args = #{ "caller": caller };
    for field in ["operation", "workspace", "model", "brief"] {
        let value = match text_of(input.get(field)) {
            Some(s) => s,
            None => return Err(`coordinator_start needs ${field}`),
        };
        if field != "brief" {
            match refuse_control_chars(field, value) { Some(e) => return Err(e), None => {} }
        }
        args.insert(field, value);
    }
    match text_of(input.get("persona")) {
        Some(persona) => { args.insert("persona", persona); }
        None => {}
    }
    call_service("start", args).await
}

// This session's own durable address, as the harness publishes it. There is no
// other source for it in this file: not an argument, not an environment
// variable, not a name somebody typed.
async fn my_address() {
    let raw = match eidolon::swarm_call("roster", #{}).await {
        Ok(v) => v,
        Err(e) => return Err(no_roster(`${e}`)),
    };
    let roster = match json::from_string(raw) {
        Ok(v) => v,
        Err(e) => return Err(no_roster(`${e}; \`swarm_call("roster")\` answered: ${raw}`)),
    };
    let me = match my_row(roster) {
        Some(r) => r,
        None => {
            return Err(no_roster(
                "the roster carries no row for this session: `me` is null or absent, and nothing else in it marks which row is the caller — so this plugin cannot tell which address is the one it would adopt from",
            ))
        }
    };
    match me.get("session") {
        Some(s) => {
            let addr = `${s}`;
            if addr == "" || addr == "null" {
                return Err(no_roster(
                    "this session has no durable address: the roster publishes `session` as null, and null means not established — not no-such-session. The harness has not minted an id into a log yet, and an adoption is keyed on that address, so none can be made until it exists",
                ))
            }
            Ok(addr)
        }
        None => Err(no_roster("this session's own row carries no `session` field at all")),
    }
}

// This session's own row: a `me` object beside the list, or the one row that
// marks itself. Either shape is the harness's to choose; neither existing is a
// refusal, never a guess from the first row and never a name.
fn my_row(roster) {
    if roster is Object {
        match roster.get("me") {
            Some(m) => {
                // `me` is null when the caller has no registration of its own —
                // `eidolon peers --json` is such a scan. Null is not a row.
                if m is Object {
                    return Some(m);
                }
                return None;
            }
            None => {}
        }
    }
    if roster is Vec {
        for row in roster {
            match row.get("me") {
                Some(flag) => {
                    if `${flag}` == "true" {
                        return Some(row);
                    }
                }
                None => {}
            }
        }
    }
    None
}

// The refusal a harness without the structured roster gets, naming exactly what is
// missing rather than degrading to something that would look like a working
// adoption. This plugin reads session state as data: it will not parse `peers`'
// prose, and it will not read the presence directory itself.
fn no_roster(why) {
    `this session has no durable seat in the roster (${why}), so an adoption cannot be recorded: it is keyed on the address the harness publishes for the adopting session, and that address is what the monitor resolves later. The plugin will not invent one — not a registration id, a name, a tag, a cwd or the first row — and will not parse \`peers\`' prose. Needed from the harness: this session's own row marked in \`swarm_call("roster", #{})\` (a \`me\` field beside the list, or \`me: true\` on the row), and a non-null \`session\`. Both asked of the core lane 2026-10-10; the field name will not change.`
}

fn text_of(v) {
    match v {
        Some(x) => {
            let s = `${x}`;
            // A JSON null arrives as the unit value, whose text form is `null`.
            if s == "null" || s == "" {
                None
            } else {
                Some(s)
            }
        }
        None => None,
    }
}

// A newline in an address or a name would forge a roster row or split a notice;
// a NUL or a tab is not a thing an address has. Refused before anything is sent.
fn refuse_control_chars(field, s) {
    if s.contains("\n") {
        return Some(`${field} contains a newline, which would forge a row rather than name a session`);
    }
    if s.contains("\r") {
        return Some(`${field} contains a carriage return`);
    }
    if s.contains("\t") {
        return Some(`${field} contains a tab`);
    }
    None
}

// The monitor service (../service). Everything that decides anything lives there,
// so that the record and the notice have one implementation and the tools stay
// thin doors onto it.
fn service() {
    #{
        name: "coordinator",
        base_url: "http://127.0.0.1:8095",
        token_file: "~/.config/eidolon/coordinator.token",
        auth: #{ header: "Authorization", prefix: "Bearer " },
        timeout_s: 30,
    }
}

// POST {method, args} to /call; the answer is {ok, result} or {ok: false, error}.
async fn call_service(method, args) {
    let body = json::to_string(#{ "method": method, "args": args })?;
    let sent = match eidolon::api_request(service(), "POST", "/call", Some(body)).await {
        Ok(r) => r,
        Err(e) => {
            return Err(`the coordinator monitor is not answering on 127.0.0.1:8095 — it is the process that holds the adoption records and watches the workers, and eidolon does not start it for you: \`eidolon plugins service approve coordinator\` once, then \`eidolon plugins service start coordinator\`; see the plugin's README (Prerequisites). The dial failed with: ${e}`);
        }
    };
    let reply = json::from_string(sent)?;
    if reply.status != 200 {
        return Err(`the coordinator monitor answered ${reply.status}: ${reply.body}`);
    }
    let out = json::from_string(reply.body)?;
    if out.ok {
        Ok(out.result)
    } else {
        Err(out.error)
    }
}
