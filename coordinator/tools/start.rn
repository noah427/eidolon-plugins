// One dispatcher-admitted managed start: the caller is derived from the harness,
// never an input. The service's token is transport auth, as for adopt; it is not
// a new authority grant. Start/retry always re-enters this registry tool's gate.
pub fn manifest() {
    #{
        name: "coordinator_start",
        description: "Start and adopt one managed worker as one operation. The harness holds the child before its first model turn; adoption is made durable before release. Name an operation id and retry ONLY the same immutable input to reconcile. An optional rank appends that rank's block (the plugin's ranks/<rank>.md) beside the persona at spawn; the monitor binds the digest of the block's exact bytes into the operation, so editing the file and retrying the same operation is refused, not re-told. A partial outcome is not success and never causes a blind replacement. The brief is one correlated delivery: a key minted once and stored before the send, so repeating this same operation carries the same key and the worker deduplicates it instead of receiving a second brief. That delivery establishes a journal record in the worker's log — not execution, not consumption, and not a turn — and it wakes nobody. Separately from it, once the brief is journaled the monitor attempts one ordinary wake naming that record rather than restating it, because a journaled record starts no turn by itself. That is one attempt per start attempt, not a guarantee of delivery: `Answered` with `delivered` or `queued` has arrived and is never sent again, while `failed`, `refused`, `partial`, an `Undeliverable` wake and a bare `Attempted` are re-attempted — so repeating the operation re-attempts only the wake, never a second brief. The child uses persistent headless chat unless `visible` is true, in which case it runs in a terminal window whose destination the service decides and pins; a visible launch refuses before any process exists unless this host can establish a no-focus map, and desktop/persona enforcement is not implied either way. Model/spend/workspace permissions are decided by this call's dispatcher, not by rank. A journaled receipt says the record is in the worker's log; it is not proof the model read it, that a turn ran, or that the work happened. `wake` is the externally tagged `WakeState`: `Answered` carries the transport's `outcome` and `words`, and `Undeliverable` carries a `why`. An `Undeliverable` wake means no wake reached the worker and the accepted work has not begun.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "additionalProperties": false,
            "properties": #{
                "operation": #{ "type": "string", "description": "Idempotency key for this exact start request, not a session address." },
                "workspace": #{ "type": "string", "description": "Existing working directory for the child; no worktree is created." },
                "model": #{ "type": "string", "description": "Explicit provider:model key; this may spend within the admitted scope." },
                "persona": #{ "type": "string", "description": "Optional requested persona; not an authority grant or verified visibility claim." },
                "rank": #{ "type": "string", "enum": ["imperator", "legatus", "tribunus", "miles", "centurio"],
                    "description": "Optional rank whose block under the plugin's ranks/ is appended beside the persona at spawn, through the CLI's generic --system-append. The monitor reads the block and binds the digest of its exact bytes into this operation's immutable input; a rank with no written block appends nothing. Not a persona rewrite, not an enforcement, and not a permission." },
                "visible": #{ "type": "boolean", "description": "Ask for a desktop-visible child: the same managed child, in a terminal window, instead of a persistent headless chat. The workspace is NOT a caller's input — the service resolves it from the Imperator's own window, once per operation, and pins it in the record, so a retry reuses the destination the operation was admitted with. On a host that cannot promise the child will not take the operator's keyboard, a visible launch refuses at its guard before any process exists. Default false." },
                "brief": #{ "type": "string", "description": "Bounded assignment journaled into the worker's own log after durable supervision, under a key minted once for this operation; not an inbox message, and it does not wake the worker." },
            },
            "required": ["operation", "workspace", "model", "brief"],
        },
    }
}

pub async fn call(input) {
    let caller = my_address().await?;
    let args = #{ "caller": caller };
    for field in ["operation", "workspace", "model", "brief"] {
        let value = match text_of(input.get(field)) {
            Some(s) => s,
            None => return Err(`coordinator_start needs ${field}`),
        };
        if field != "brief" {
            match refuse_control_chars(field, value) { Some(e) => return Err(e), None => {} }
        }
        args.insert(field, value);
    }
    match text_of(input.get("persona")) {
        Some(persona) => { args.insert("persona", persona); }
        None => {}
    }
    // The rank's name only. There is no `rank_digest` argument to send: the
    // monitor reads the block itself and binds the digest of those exact bytes,
    // so a retry whose file changed refuses instead of injecting new text.
    match text_of(input.get("rank")) {
        Some(rank) => match refuse_control_chars("rank", rank) {
            Some(e) => return Err(e),
            None => { args.insert("rank", rank); }
        },
        None => {}
    }
    // A visible launch is a shape the caller may ask for and nothing more. There
    // is no destination to send and none to invent: the service resolves it from
    // the Imperator's own window on the first attempt and pins it in the record,
    // so a retry reuses the admitted number instead of resolving a second time.
    // Sent only when true, which keeps a headless call's payload byte-identical
    // to what it was before this argument existed.
    match input.get("visible") {
        Some(v) => {
            let said = `${v}`;
            if said == "true" {
                args.insert("visible", true);
            } else if said != "false" {
                return Err(`coordinator_start: \`visible\` must be true or false, not ${said}: a launch shape is not a string to be guessed at`);
            }
        }
        None => {}
    }
    call_service("start", args).await
}

// This session's own durable address, as the harness publishes it. There is no
// other source for it in this file: not an argument, not an environment
// variable, not a name somebody typed.
async fn my_address() {
    let raw = match eidolon::swarm_call("roster", #{}).await {
        Ok(v) => v,
        Err(e) => return Err(no_roster(`${e}`)),
    };
    let roster = match json::from_string(raw) {
        Ok(v) => v,
        Err(e) => return Err(no_roster(`${e}; \`swarm_call("roster")\` answered: ${raw}`)),
    };
    let me = match my_row(roster) {
        Some(r) => r,
        None => {
            return Err(no_roster(
                "the roster carries no row for this session: `me` is null or absent, and nothing else in it marks which row is the caller — so this plugin cannot tell which address is the one it would adopt from",
            ))
        }
    };
    match me.get("session") {
        Some(s) => {
            let addr = `${s}`;
            if addr == "" || addr == "null" {
                return Err(no_roster(
                    "this session has no durable address: the roster publishes `session` as null, and null means not established — not no-such-session. The harness has not minted an id into a log yet, and an adoption is keyed on that address, so none can be made until it exists",
                ))
            }
            Ok(addr)
        }
        None => Err(no_roster("this session's own row carries no `session` field at all")),
    }
}

// This session's own row: a `me` object beside the list, or the one row that
// marks itself. Either shape is the harness's to choose; neither existing is a
// refusal, never a guess from the first row and never a name.
fn my_row(roster) {
    if roster is Object {
        match roster.get("me") {
            Some(m) => {
                // `me` is null when the caller has no registration of its own —
                // `eidolon peers --json` is such a scan. Null is not a row.
                if m is Object {
                    return Some(m);
                }
                return None;
            }
            None => {}
        }
    }
    if roster is Vec {
        for row in roster {
            match row.get("me") {
                Some(flag) => {
                    if `${flag}` == "true" {
                        return Some(row);
                    }
                }
                None => {}
            }
        }
    }
    None
}

// The refusal a harness without the structured roster gets, naming exactly what is
// missing rather than degrading to something that would look like a working
// adoption. This plugin reads session state as data: it will not parse `peers`'
// prose, and it will not read the presence directory itself.
fn no_roster(why) {
    `this session has no durable seat in the roster (${why}), so an adoption cannot be recorded: it is keyed on the address the harness publishes for the adopting session, and that address is what the monitor resolves later. The plugin will not invent one — not a registration id, a name, a tag, a cwd or the first row — and will not parse \`peers\`' prose. Needed from the harness: this session's own row marked in \`swarm_call("roster", #{})\` (a \`me\` field beside the list, or \`me: true\` on the row), and a non-null \`session\`. Both asked of the core lane 2026-10-10; the field name will not change.`
}

fn text_of(v) {
    match v {
        Some(x) => {
            let s = `${x}`;
            // A JSON null arrives as the unit value, whose text form is `null`.
            if s == "null" || s == "" {
                None
            } else {
                Some(s)
            }
        }
        None => None,
    }
}

// A newline in an address or a name would forge a roster row or split a notice;
// a NUL or a tab is not a thing an address has. Refused before anything is sent.
fn refuse_control_chars(field, s) {
    if s.contains("\n") {
        return Some(`${field} contains a newline, which would forge a row rather than name a session`);
    }
    if s.contains("\r") {
        return Some(`${field} contains a carriage return`);
    }
    if s.contains("\t") {
        return Some(`${field} contains a tab`);
    }
    None
}

// The monitor service (../service). Everything that decides anything lives there,
// so that the record and the notice have one implementation and the tools stay
// thin doors onto it.
fn service() {
    #{
        name: "coordinator",
        base_url: "http://127.0.0.1:8095",
        token_file: "~/.config/eidolon/coordinator.token",
        auth: #{ header: "Authorization", prefix: "Bearer " },
        timeout_s: 30,
    }
}

// POST {method, args} to /call; the answer is {ok, result} or {ok: false, error}.
async fn call_service(method, args) {
    let body = json::to_string(#{ "method": method, "args": args })?;
    let sent = match eidolon::api_request(service(), "POST", "/call", Some(body)).await {
        Ok(r) => r,
        Err(e) => {
            return Err(`the coordinator monitor is not answering on 127.0.0.1:8095 — it is the process that holds the adoption records and watches the workers, and eidolon does not start it for you: \`eidolon plugins service approve coordinator\` once, then \`eidolon plugins service start coordinator\`; see the plugin's README (Prerequisites). The dial failed with: ${e}`);
        }
    };
    let reply = json::from_string(sent)?;
    if reply.status != 200 {
        return Err(`the coordinator monitor answered ${reply.status}: ${reply.body}`);
    }
    let out = json::from_string(reply.body)?;
    if out.ok {
        Ok(out.result)
    } else {
        Err(out.error)
    }
}
