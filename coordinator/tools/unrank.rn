// `coordinator_unrank`: take a rank off a session, as **a tag the session itself
// carries**.
//
// The rank is `rank:<word>` among the session's own tags, so releasing it is one
// family removal: every tag beginning `rank:` goes, whatever word it names, and the
// session's label and every tag outside that prefix are left exactly as they stand.
// The session's own name is not touched — a rank was presentation, and the name the
// session wrote stays its own.
//
// A release is **not a silent no-op**: the roster is read first, and a session that
// carries no rank tag is refused with that reason rather than answered as if something
// had been removed. A session with no live registration has no row, and the refusal
// says so — a tag belongs to a registration, so there is nothing to release.
pub fn manifest() {
    #{
        name: "coordinator_unrank",
        description: "Take a session's rank off: every `rank:` tag on that session is removed and its label and every other tag are left as they stand. Refused when the session carries no rank, and refused when no live registration carries the address — a release is not a silent no-op. Presentation only.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "session": #{
                    "type": "string",
                    "description": "The session's durable address, exactly as `eidolon peers` prints it.",
                },
            },
            "required": ["session"],
        },
    }
}

pub async fn call(input) {
    let session = match text_of(input.get("session")) {
        Some(s) => s,
        None => return Err("coordinator_unrank needs `session`: the durable address whose rank is being released"),
    };
    match refuse_control_chars("session", session) {
        Some(e) => return Err(e),
        None => {}
    }
    // What stands now, so the refusal can be about this session rather than about the
    // act. The write below is a family removal and would be safe without this read; the
    // read is here to keep the release from being a silent no-op.
    let rows = match roster().await {
        Ok(rows) => rows,
        Err(e) => return Err(e),
    };
    let claimants = claimants(rows, session);
    if claimants.len() == 0 {
        return Err(`no live session carries the address \`${session}\`, so no rank stands to release: a rank is a tag on a registration, and a session that is not registered now has none to remove`);
    }
    if claimants.len() > 1 {
        return Err(`${claimants.len()} live sessions claim the address \`${session}\`; this will not guess which one carries the rank, and nothing was changed`);
    }
    let standing = rank_of(claimants[0]);
    if standing == "" {
        return Err(`\`${session}\` carries no \`rank:\` tag, so there is nothing to release and nothing was written — a release is not a silent no-op`);
    }
    let said = match eidolon::swarm_call("tag", #{
        "session": session,
        "remove_prefix": "rank:",
    })
        .await
    {
        Ok(v) => `${v}`,
        Err(e) => return Err(`the rank was not released: ${e}`),
    };
    `${said}. \`${standing}\` is gone; the session's own label and every tag outside \`rank:\` are untouched`
}

// The roster as rows, or the reason it could not be read. A roster that cannot be read
// is not a roster that saw nobody.
async fn roster() {
    let raw = match eidolon::swarm_call("roster", #{}).await {
        Ok(v) => v,
        Err(e) => return Err(`the roster could not be read (${e}), so nothing here is a claim about any session's rank, and nothing was changed`),
    };
    let parsed = match json::from_string(raw) {
        Ok(v) => v,
        Err(e) => return Err(`the roster answered something that is not JSON (${e}; \`swarm_call("roster")\` said: ${raw}), so nothing was changed`),
    };
    Ok(roster_rows(parsed))
}

fn roster_rows(roster) {
    let out = [];
    if roster is Vec {
        return roster;
    }
    if roster is Object {
        match roster.get("sessions") {
            Some(s) => {
                if s is Vec {
                    for row in s {
                        out.push(row);
                    }
                }
            }
            None => {}
        }
        match roster.get("me") {
            Some(me) => {
                if me is Object {
                    out.push(me);
                }
            }
            None => {}
        }
    }
    out
}

fn claimants(rows, session) {
    let out = [];
    for row in rows {
        if row is Object && text(row, "session") == session {
            out.push(row);
        }
    }
    out
}

// The rank tag a row presents, or the empty string. Read off the row's presented tags,
// which are the session's authored set plus the harness's derived ones — the authored
// `rank:` tag is the only one this prefix can match.
fn rank_of(row) {
    for tag in tags_of(row) {
        let t = `${tag}`;
        if t.starts_with("rank:") {
            return t;
        }
    }
    ""
}

fn tags_of(row) {
    let out = [];
    match row.get("tags") {
        Some(t) => {
            if t is Vec {
                for tag in t {
                    out.push(tag);
                }
            }
        }
        None => {}
    }
    out
}

// Everything below is the same in every coordinator_*.rn: upstream eidolon compiles each
// tool file on its own, so a tool file is handed over whole.

fn text(row, key) {
    match row.get(key) {
        Some(s) => {
            let v = `${s}`;
            if v == "null" || v == "" {
                ""
            } else {
                v
            }
        }
        None => "",
    }
}

fn text_of(v) {
    match v {
        Some(x) => {
            let s = `${x}`;
            // A JSON null arrives as the unit value, whose text form is `null`.
            if s == "null" || s == "" {
                None
            } else {
                Some(s)
            }
        }
        None => None,
    }
}

// A newline in an address would forge a roster row or split a notice; a NUL or a tab is
// not a thing an address has. Refused before anything is sent.
fn refuse_control_chars(field, s) {
    if s.contains("\n") {
        return Some(`${field} contains a newline, which would forge a row rather than name a session`);
    }
    if s.contains("\r") {
        return Some(`${field} contains a carriage return`);
    }
    if s.contains("\t") {
        return Some(`${field} contains a tab`);
    }
    None
}
