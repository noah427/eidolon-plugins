// `coordinator_unrank`: take a rank off a session, as **a tag the session itself
// carries**.
//
// The rank is `rank:<word>` among the session's own tags, so releasing it is one family
// removal: every tag beginning `rank:` goes, whatever word it names, and the session's
// label and every tag outside that prefix are left exactly as they stand. The session's
// own name is not touched — a rank was presentation, and the name the session wrote stays
// its own.
//
// **It is an idempotent desired-state act, and says only what the door answered.** "This
// session carries no rank" is the state asked for, so a session that already carries none
// is not a failure and is not dressed as one: the door's answer distinguishes what it
// wrote from what was already true, and that answer — the set read back under the owner's
// own lock — is the whole of what this tool reports. It does **not** inspect the roster
// first to announce what it expects to remove: an observation taken before the write is
// not evidence of what the write did, and a concurrent change between the two would make
// either a claim ("the rank is gone") or a refusal ("there is nothing to release") that the
// act itself never established.
pub fn manifest() {
    #{
        name: "coordinator_unrank",
        description: "Take a session's rank off: every `rank:` tag on that session is removed and its label and every other tag are left as they stand. Idempotent — a session that already carries no rank is reported as already true rather than as a failure — and the answer is the set the session's own registration holds after the act, never a prediction from a scan. Refused when no live registration carries the address, because a tag belongs to a registration. Presentation only.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "session": #{
                    "type": "string",
                    "description": "The session's durable address, exactly as `eidolon peers` prints it.",
                },
            },
            "required": ["session"],
        },
    }
}

pub async fn call(input) {
    let session = match text_of(input.get("session")) {
        Some(s) => s,
        None => return Err("coordinator_unrank needs `session`: the durable address whose rank is being released"),
    };
    match refuse_control_chars("session", session) {
        Some(e) => return Err(e),
        None => {}
    }
    // One act, one answer. No roster read of its own: the door resolves the address,
    // performs the family removal under the owner's lock and reports the set that stands,
    // and anything this tool said on top of that would be a second, weaker observation
    // dressed as the result.
    let said = match eidolon::swarm_call("tag", #{
        "session": session,
        "remove_prefix": "rank:",
    })
        .await
    {
        Ok(v) => `${v}`,
        Err(e) => return Err(`the rank was not released: ${e}`),
    };
    `${said}. That is read back from the session's own registration: no \`rank:\` tag stands on it now, and its label and every tag outside that prefix are exactly as they were`
}

// Everything below is the same in every coordinator_*.rn: upstream eidolon compiles each
// tool file on its own, so a tool file is handed over whole.

fn text_of(v) {
    match v {
        Some(x) => {
            let s = `${x}`;
            // A JSON null arrives as the unit value, whose text form is `null`.
            if s == "null" || s == "" {
                None
            } else {
                Some(s)
            }
        }
        None => None,
    }
}

// A newline in an address would forge a roster row or split a notice; a NUL or a tab is
// not a thing an address has. Refused before anything is sent.
fn refuse_control_chars(field, s) {
    if s.contains("\n") {
        return Some(`${field} contains a newline, which would forge a row rather than name a session`);
    }
    if s.contains("\r") {
        return Some(`${field} contains a carriage return`);
    }
    if s.contains("\t") {
        return Some(`${field} contains a tab`);
    }
    None
}
