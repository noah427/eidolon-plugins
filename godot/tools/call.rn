// `godot_call`: one method on one node. The verb that can do anything a node can
// be asked to do, which is why the three that would take the node out of the scene
// are refused by name, and why the answer says out loud that a call is not an
// editor action and cannot be taken back.
pub fn manifest() {
    #{
        name: "godot_call",
        description: "Call one method on one node in the scene a Godot editor is editing, and report what it returned. `expect` is required and is the fingerprint godot_node reported; the node is re-resolved at the call and the verb refuses — calling nothing — if what is at that path is not the one that was inspected. `args` is the array of arguments, in order; an argument that JSON cannot carry — a Vector2, a StringName, a NodePath — is named as {\"var\": \"Vector2(1, 2)\"}, a literal in the spelling godot_node reports, and anything else is passed as the JSON value it is. Three methods are refused: `free`, `queue_free` and `replace_by`, because they take a node out of the scene and leave a hole that nothing repairs. Everything else the node has is callable, including engine methods godot_node does not list. A call is not an editor action — it is not in the undo history, the operator cannot take it back with Ctrl-Z, and the answer says so every time.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "path": #{ "type": "string", "description": "The node's path relative to the edited scene's root: \".\" for the root itself, \"Player\", \"Player/Sprite\"." },
                "expect": #{ "type": "string", "description": "The fingerprint godot_node reported for that node. Required; the verb refuses if the node at that path is not this one." },
                "method": #{ "type": "string", "description": "The method to call, e.g. \"poke\" or \"emit_signal\"." },
                "args": #{ "type": "array", "description": "The method's arguments in order. Default []. A Godot-only value goes in as {\"var\": \"Vector2(1, 2)\"}." },
            },
            "required": ["path", "expect", "method"],
        },
    }
}

pub async fn call(input) {
    call_service("call", input).await
}

// ---------------------------------------------------------------------------
// Everything below is the same in every godot_*.rn: upstream compiles each of
// these files on its own, and a tool file is meant to be handed over whole.

// The bridge host (../service). `eidolon plugins service start godot` runs it, and
// the editor's addon dials it; the tools come in the other side. Change the port
// here and the host's EIDOLON_GODOT_PORT together, and the token file here and
// EIDOLON_GODOT_TOKEN_FILE.
fn service() {
    #{
        name: "godot",
        base_url: "http://127.0.0.1:8092",
        token_file: "~/.config/eidolon/godot.token",
        auth: #{ header: "Authorization", prefix: "Bearer " },
        timeout_s: 180,
    }
}

// POST {method, args} to /call; the answer is {ok, result} or {ok: false, error}.
async fn call_service(method, args) {
    let body = json::to_string(#{ "method": method, "args": args })?;
    // A dial that fails means the host is not running. There is one command that
    // fixes that, so the answer names it rather than leaving a connection refusal
    // to be read.
    let sent = match eidolon::api_request(service(), "POST", "/call", Some(body)).await {
        Ok(r) => r,
        Err(e) => {
            return Err(`the godot bridge is not answering on 127.0.0.1:8092 — the eidolon-godot service has to be running (\`eidolon plugins service start godot\`); see the plugin's README (Prerequisites). The dial failed with: ${e}`);
        }
    };
    let reply = json::from_string(sent)?;
    if reply.status != 200 {
        return Err(`the godot bridge answered ${reply.status}: ${reply.body}`);
    }
    let out = json::from_string(reply.body)?;
    if out.ok {
        Ok(out.result)
    } else {
        Err(out.error)
    }
}
