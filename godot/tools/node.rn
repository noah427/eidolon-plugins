// `godot_node`: one node, in detail, with the fingerprint a mutating verb needs.
//
// The fingerprint is the identity that a path cannot be: instance id, class and
// script. A node deleted and replaced at the same path is a different node, and
// this is what lets godot_set say so instead of writing into the wrong one.
pub fn manifest() {
    #{
        name: "godot_node",
        description: "One node of the scene a Godot editor is editing, named by its path from the edited scene's root (\".\" is the root), reported in full: class, attached script, owner, groups, the methods its own script declares with their argument names, its signals with their argument names and how many things are connected to each, its direct children, and its properties. Each property carries its Godot type, `repr` — the literal the inspector would show — and a `value` only when JSON carries it without changing its shape, so a Vector2 is read from `repr` and written back through godot_set's value_text. By default the properties are the node's exported script variables; all: true widens that to everything the inspector shows, and `filter` keeps the ones whose name contains a string. The `fingerprint` in the answer is what godot_set and godot_call must be handed as `expect`.",
        approval: "read_only",
        input_schema: #{
            "type": "object",
            "properties": #{
                "path": #{ "type": "string", "description": "The node's path relative to the edited scene's root: \".\" for the root itself, \"Player\", \"Player/Sprite\". A leading \"/\" is refused." },
                "all": #{ "type": "boolean", "description": "Report every property the inspector shows and every signal the node has, not just what its own script declares. Default false." },
                "filter": #{ "type": "string", "description": "Keep only properties whose name contains this string, case-insensitively." },
                "max": #{ "type": "integer", "description": "The most properties to return, 1 to 2000. Default 200; the answer says whether it truncated." },
            },
            "required": ["path"],
        },
    }
}

pub async fn call(input) {
    call_service("node", input).await
}

// ---------------------------------------------------------------------------
// Everything below is the same in every godot_*.rn: upstream compiles each of
// these files on its own, and a tool file is meant to be handed over whole.

// The bridge host (../service). `eidolon plugins service start godot` runs it, and
// the editor's addon dials it; the tools come in the other side. Change the port
// here and the host's EIDOLON_GODOT_PORT together, and the token file here and
// EIDOLON_GODOT_TOKEN_FILE.
fn service() {
    #{
        name: "godot",
        base_url: "http://127.0.0.1:8092",
        token_file: "~/.config/eidolon/godot.token",
        auth: #{ header: "Authorization", prefix: "Bearer " },
        timeout_s: 180,
    }
}

// POST {method, args} to /call; the answer is {ok, result} or {ok: false, error}.
async fn call_service(method, args) {
    let body = json::to_string(#{ "method": method, "args": args })?;
    // A dial that fails means the host is not running. There is one command that
    // fixes that, so the answer names it rather than leaving a connection refusal
    // to be read.
    let sent = match eidolon::api_request(service(), "POST", "/call", Some(body)).await {
        Ok(r) => r,
        Err(e) => {
            return Err(`the godot bridge is not answering on 127.0.0.1:8092 — the eidolon-godot service has to be running (\`eidolon plugins service start godot\`); see the plugin's README (Prerequisites). The dial failed with: ${e}`);
        }
    };
    let reply = json::from_string(sent)?;
    if reply.status != 200 {
        return Err(`the godot bridge answered ${reply.status}: ${reply.body}`);
    }
    let out = json::from_string(reply.body)?;
    if out.ok {
        Ok(out.result)
    } else {
        Err(out.error)
    }
}
