// `godot_run`: play the project, or stop it. The one verb here whose effect is a
// window on somebody's screen, which is why nothing else reaches for it and why
// the state it changes is reported back rather than assumed.
pub fn manifest() {
    #{
        name: "godot_run",
        description: "Play or stop the project the Godot editor has open. `action: \"play\"` with `scene` naming \"main\" (the project's main scene, the default), \"current\" (the scene being edited) or a scene path in the project; or `action: \"stop\"`. Playing starts a second process — a window on the operator's screen, or a headless run if the editor is headless — and it runs that project's code. A play while the editor already reports the project as playing is refused, and so is a stop when nothing is playing, so a call cannot leave two runs going or report a stop that stopped nothing. The editor reports a run as playing on its own frame, so the call waits for it to agree before saying it played, and says what the editor reports if it never agrees.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "action": #{ "type": "string", "enum": ["play", "stop"], "description": "What to do. Required." },
                "scene": #{ "type": "string", "description": "For `play`: \"main\", \"current\", or a scene path in this project like \"res://scenes/Main.tscn\". Default \"main\"." },
            },
            "required": ["action"],
        },
    }
}

pub async fn call(input) {
    let action = word(input, "action");
    let out = call_service("run", input).await?;
    let want = action == "play";
    if want == false && action != "stop" {
        return Ok(out);
    }
    if bool_field(out, "matched") {
        return Ok(out);
    }
    // The editor starts and stops the run on its own frame. This waits for the
    // editor's own answer to agree with what was asked, and refuses to report the
    // request as the result if it never does.
    let last = false;
    for _ in 0..POLL_TRIES {
        let status = call_service("status", #{}).await?;
        if !bool_field(status, "attached") {
            return Err(`the editor's bridge connection went away while waiting for the project to ${action}: ${str_field(status, "reason")}`);
        }
        last = state_bool(status, "playing");
        if last == want {
            return Ok(#{
                action: action,
                scene: str_field(out, "scene"),
                playing: last,
                matched: true,
                note: `the editor agreed after the call, so the ${action} did happen; ask godot_status for the run's state from here`,
            });
        }
        sleep_ms(POLL_MS).await?;
    }
    Err(`asked the editor to ${action} the project and it still reports playing=${last} after ${POLL_TRIES * POLL_MS}ms. Nothing was retried; look at the editor`)
}
// ---------------------------------------------------------------------------
// Waiting on an editor that does the thing on its own frame. A tool file has no
// clock but `sleep`, and the wait is bounded by a count of tries rather than by a
// deadline: what it buys is that a verb which asked for something verifies it
// happened instead of trusting that it did.

const POLL_TRIES = 15;
const POLL_MS = 200;
const EXEC_TIMEOUT_S = 15;

fn word(input, name) {
    match input.get(name) {
        Some(v) => `${v}`,
        None => "",
    }
}

fn str_field(m, name) {
    match m.get(name) {
        Some(v) => if v is String { v } else { `${v}` },
        None => "",
    }
}

fn bool_field(m, name) {
    match m.get(name) {
        Some(v) => if v is bool { v } else { false },
        None => false,
    }
}

// The editor's own half of a status answer. "" and false when no editor is
// attached, which every caller below checks for separately so that "not attached"
// never reads as "the editor said no".
fn state_text(status, name) {
    match status.get("editor_state") {
        Some(state) => str_field(state, name),
        None => "",
    }
}

fn state_bool(status, name) {
    match status.get("editor_state") {
        Some(state) => bool_field(state, name),
        None => false,
    }
}

// `exec` renders a failed call into its output rather than raising, so a command
// that never ran has to be told apart from one that answered.
fn exec_failed(out) {
    out.starts_with("[exit code") || out.starts_with("[timed out")
        || out.starts_with("[cancelled") || out.starts_with("[killed")
}

async fn sleep_ms(ms) {
    if ms <= 0 {
        return Ok(());
    }
    let secs = `${ms as f64 / 1000.0}`;
    let out = eidolon::exec("sleep", [secs], Some(EXEC_TIMEOUT_S)).await?;
    if exec_failed(out) {
        return Err(`sleep ${secs} failed: ${out.trim()}`);
    }
    Ok(())
}

// ---------------------------------------------------------------------------
// Everything below is the same in every godot_*.rn: upstream compiles each of
// these files on its own, and a tool file is meant to be handed over whole.

// The bridge host (../service). `eidolon plugins service start godot` runs it, and
// the editor's addon dials it; the tools come in the other side. Change the port
// here and the host's EIDOLON_GODOT_PORT together, and the token file here and
// EIDOLON_GODOT_TOKEN_FILE.
fn service() {
    #{
        name: "godot",
        base_url: "http://127.0.0.1:8092",
        token_file: "~/.config/eidolon/godot.token",
        auth: #{ header: "Authorization", prefix: "Bearer " },
        timeout_s: 180,
    }
}

// POST {method, args} to /call; the answer is {ok, result} or {ok: false, error}.
async fn call_service(method, args) {
    let body = json::to_string(#{ "method": method, "args": args })?;
    // A dial that fails means the host is not running. There is one command that
    // fixes that, so the answer names it rather than leaving a connection refusal
    // to be read.
    let sent = match eidolon::api_request(service(), "POST", "/call", Some(body)).await {
        Ok(r) => r,
        Err(e) => {
            return Err(`the godot bridge is not answering on 127.0.0.1:8092 — the eidolon-godot service has to be running (\`eidolon plugins service start godot\`); see the plugin's README (Prerequisites). The dial failed with: ${e}`);
        }
    };
    let reply = json::from_string(sent)?;
    if reply.status != 200 {
        return Err(`the godot bridge answered ${reply.status}: ${reply.body}`);
    }
    let out = json::from_string(reply.body)?;
    if out.ok {
        Ok(out.result)
    } else {
        Err(out.error)
    }
}
