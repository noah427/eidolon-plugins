// `hyprland_scroll`: scroll inside a window that was inspected a moment ago, at a point
// in it. The pointer is put over that point first — an axis event goes to whatever the
// pointer is over, so the target window is only the target if the pointer is inside it —
// and the same re-check-before-act discipline as hyprland_click applies: identity and
// geometry are re-read before the pointer moves and again before anything is scrolled,
// and a pointer that did not arrive is a refusal, not a scroll in the wrong window.

pub fn manifest() {
    #{
        name: "hyprland_scroll",
        description: "Scroll inside a Hyprland window: window is an address from hyprland_inspect, expect is the fingerprint that was inspected, dx/dy are the scroll amounts (positive dy scrolls down, positive dx scrolls right), and x/y are the window-relative point to scroll at (default: the middle of the window). The pointer is moved over that point first and confirmed there, and then the monitors, the windows and the pointer's position are read again immediately before the axis events go out; a stale, moved, disappeared or non-visible target, a target whose output switched away from the workspace it is on, a point that is no longer inside it, or a pointer that did not arrive, is refused rather than scrolled. Moving the pointer may focus the window under it (input:follow_mouse).",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "window": #{ "type": "string", "description": "The window's address from hyprland_inspect." },
                "expect": #{ "type": "string", "description": "The fingerprint hyprland_inspect reported for that window. Required." },
                "dy": #{ "type": "number", "description": "Vertical scroll: positive scrolls down, negative up. Range -100 to 100." },
                "dx": #{ "type": "number", "description": "Horizontal scroll: positive scrolls right. Default 0." },
                "x": #{ "type": "integer", "description": "Window-relative x to scroll at (default: the middle of the window)." },
                "y": #{ "type": "integer", "description": "Window-relative y to scroll at (default: the middle of the window)." },
                "global": #{ "type": "boolean", "description": "Treat x and y as layout coordinates instead of window-relative ones." },
                "settle_ms": #{ "type": "integer", "description": "Milliseconds to let the pointer settle before scrolling. Default 50." },
            },
            "required": ["window", "expect", "dy"],
        },
    }
}

pub async fn call(input) {
    let address = word(input, "window");
    if address == "" {
        return Ok(refuse("window is required: the address hyprland_inspect reported"));
    }
    if !looks_like_address(address) {
        return Ok(refuse(`window is a window address like 0x562e1ac89e30, not "${address}"`));
    }
    let dy = num_input(input, "dy", 0.0);
    let dx = num_input(input, "dx", 0.0);
    if dy == 0.0 && dx == 0.0 {
        return Ok(refuse("dy (and optionally dx) must not both be zero: there would be nothing to scroll"));
    }
    if dy < -100.0 || dy > 100.0 || dx < -100.0 || dx > 100.0 {
        return Ok(refuse(`scroll amounts are -100 to 100 (got dy ${dy}, dx ${dx}); send a few of them instead of one large one`));
    }
    let settle = int_input(input, "settle_ms", 50);
    if settle < 0 || settle > 5000 {
        return Ok(refuse(`settle_ms is 0 to 5000, not ${settle}`));
    }

    let expect = word(input, "expect");
    let monitors = hypr_json(["-j", "monitors"]).await?;
    let clients = hypr_json(["-j", "clients"]).await?;
    match check_target(clients, address, expect) {
        None => {}
        Some(reason) => return Ok(refuse(reason)),
    }
    let w = match find_window(clients, address) {
        Some(w) => w,
        None => return Ok(refuse(`no window with address ${address}`)),
    };
    if !bool_field(w, "mapped") {
        return Ok(refuse(`window ${address} is not mapped (withdrawn or still mapping)`));
    }
    if bool_field(w, "hidden") {
        return Ok(refuse(`window ${address} is hidden: the compositor is not drawing it, so the pointer cannot be put inside it`));
    }
    if !window_on_screen(monitors, w) {
        let ws = workspace_of_window(w);
        return Ok(refuse(`window ${address} is on workspace ${int_field(ws, "id")}, which no output is showing: the pointer cannot be put inside it, so the scroll would go to whatever is at that place instead. hyprland_focus would switch to it — a visible change this tool will not make on its own`));
    }
    if !bool_field(w, "acceptsInput") {
        return Ok(refuse(`window ${address} does not accept input right now, so it would not receive the scroll`));
    }
    let size = pair(w, "size");
    let x = int_input(input, "x", -1);
    let y = int_input(input, "y", -1);
    let px = if x < 0 { size[0] / 2 } else { x };
    let py = if y < 0 { size[1] / 2 } else { y };
    let point = match target_point(w, input, px, py) {
        Ok(p) => p,
        Err(e) => return Ok(refuse(`${e}`)),
    };
    require_tool(INPUT_POINTER).await?;

    let moved = match point_pointer_at(point.x, point.y, settle).await {
        Ok(m) => m,
        Err(e) => return Ok(refuse(`${e}`)),
    };
    // The same guard the click makes before every press, for the same reason: the pointer took
    // time to get there, and an output that switched the workspace it shows in that time leaves
    // the target's own fingerprint unchanged — same window, same workspace, on screen nowhere —
    // so the monitors are read again here, with the windows and the pointer's position, rather
    // than trusting the check made before the move.
    match revalidate_at_pointer(address, expect, point).await {
        Ok(()) => {}
        Err(reason) => {
            return Ok(refuse(`the pointer is at ${point.x},${point.y} and nothing was scrolled: ${reason}`));
        }
    }

    let args = ["pointer", "scroll", num_text(dy), num_text(dx)];
    run_client(INPUT_POINTER, args).await?;

    let after_active = active_address().await?;
    let lines = [];
    lines.push(`scrolled dy=${num_text(dy)} dx=${num_text(dx)} with the pointer at layout ${point.x},${point.y} (window-relative ${point.local.x},${point.local.y}) in ${describe(w)}`);
    lines.push(`  pointer: ${moved.from.x},${moved.from.y} -> ${point.x},${point.y}, confirmed by the compositor before the scroll`);
    lines.push(`  focused now: ${after_active}`);
    lines.push(`  what is not guaranteed: the pointer move, the last re-check and the axis events are separate compositor calls, and the amount a client treats as one notch is the client's business — the result says what was sent, not how far the target scrolled. Moving the pointer may have focused ${address} (input:follow_mouse)`);
    Ok(join(lines, "\n"))
}

// ---------------------------------------------------------------------------
// Everything below is the same in every hyprland tool file: upstream compiles each
// tool file on its own, and a tool file is meant to be handed over whole.

const HYPRCTL = "hyprctl";
const EXEC_TIMEOUT_S = 15;

fn join(parts, sep) {
    let out = "";
    let first = true;
    for p in parts {
        if first {
            first = false;
        } else {
            out += sep;
        }
        out += p;
    }
    out
}

// `exec` renders a failed call into its output rather than raising, so a command that
// never ran has to be told apart from one that answered.
fn exec_failed(out) {
    out.starts_with("[exit code") || out.starts_with("[timed out")
        || out.starts_with("[cancelled") || out.starts_with("[killed")
}

fn refuse(msg) {
    #{ content: msg, is_error: true }
}

async fn hypr(args) {
    let out = eidolon::exec(HYPRCTL, args, Some(EXEC_TIMEOUT_S)).await?;
    if exec_failed(out) {
        return Err(`hyprctl ${join(args, " ")} failed: ${out.trim()} -- is Hyprland running, and is this process inside its session (WAYLAND_DISPLAY, HYPRLAND_INSTANCE_SIGNATURE)?`);
    }
    Ok(out)
}

async fn hypr_json(args) {
    let out = hypr(args).await?;
    match json::from_string(out) {
        Ok(v) => Ok(v),
        Err(e) => Err(`hyprctl ${join(args, " ")} did not answer JSON (${e}): ${out.trim()}`),
    }
}

fn word(input, name) {
    match input.get(name) {
        Some(v) => if v is String { v.trim() } else { `${v}` },
        None => "",
    }
}

fn got(input, name) {
    input.get(name)
}

fn as_int(v) {
    if v is i64 {
        v
    } else if v is f64 {
        v as i64
    } else {
        0
    }
}

fn as_float(v) {
    if v is f64 {
        v
    } else if v is i64 {
        v as f64
    } else {
        0.0
    }
}

fn num_input(input, name, dflt) {
    match input.get(name) {
        Some(v) => if v is i64 || v is f64 { as_float(v) } else { dflt },
        None => dflt,
    }
}

fn int_input(input, name, dflt) {
    match input.get(name) {
        Some(v) => if v is i64 || v is f64 { as_int(v) } else { dflt },
        None => dflt,
    }
}

fn bool_input(input, name, dflt) {
    match input.get(name) {
        Some(v) => if v is bool { v } else { dflt },
        None => dflt,
    }
}

fn str_field(m, name) {
    match m.get(name) {
        Some(v) => if v is String { v } else { `${v}` },
        None => "",
    }
}

fn int_field(m, name) {
    match m.get(name) {
        Some(v) => as_int(v),
        None => 0,
    }
}

fn bool_field(m, name) {
    match m.get(name) {
        Some(v) => if v is bool { v } else { false },
        None => false,
    }
}

fn float_field(m, name, dflt) {
    match m.get(name) {
        Some(v) => if v is f64 { v } else if v is i64 { v as f64 } else { dflt },
        None => dflt,
    }
}

fn vec_field(m, name) {
    match m.get(name) {
        Some(v) => if v is Vec { v } else { [] },
        None => [],
    }
}

// A pair of layout coordinates or a w×h: a missing or malformed one is [0, 0].
fn pair(m, name) {
    let v = vec_field(m, name);
    if v.len() == 2 {
        [as_int(v[0]), as_int(v[1])]
    } else {
        [0, 0]
    }
}

fn geometry_known(m) {
    vec_field(m, "at").len() == 2 && vec_field(m, "size").len() == 2
}

fn workspace_of_window(w) {
    match w.get("workspace") {
        Some(v) => v,
        None => #{},
    }
}

// Whether an output is showing this workspace right now. hyprctl's workspace records carry no
// `visible` field at all (Hyprland 0.56 prints id, name, monitor, monitorID, windows,
// hasfullscreen, lastwindow, lastwindowtitle, ispersistent, tiledLayout), so it has to be
// worked out from the monitors: a workspace is on a screen when it is an enabled output's
// active workspace, or the special workspace that output has open — specials are named
// `special:<name>` and the monitor reports that same name, which is how the two are matched.
// This is the compositor's own rule (CWorkspace::isVisibleNotCovered), and an open special does
// not stop the workspace underneath it from being shown: opening one never clears the other's
// visible flag (Monitor::setSpecialWorkspace), so both answer true here.
fn shown_by(monitors, ws) {
    let id = int_field(ws, "id");
    let name = str_field(ws, "name");
    for m in monitors {
        if bool_field(m, "disabled") {
            continue;
        }
        match m.get("activeWorkspace") {
            Some(a) => {
                if id > 0 && int_field(a, "id") == id {
                    return Some(str_field(m, "name"));
                }
            }
            None => {}
        }
        match m.get("specialWorkspace") {
            Some(s) => {
                if name != "" && str_field(s, "name") == name {
                    return Some(str_field(m, "name"));
                }
            }
            None => {}
        }
    }
    None
}

fn workspace_shown(monitors, ws) {
    match shown_by(monitors, ws) {
        Some(name) => name != "",
        None => false,
    }
}

// A special workspace is the compositor's own id range for one (WorkspaceQueryCore: ids from
// SPECIAL_WORKSPACE_START, -99, up to -2), not a field hyprctl reports.
fn is_special_workspace(ws) {
    let id = int_field(ws, "id");
    id >= -99 && id <= -2
}

fn monitor_by_id(monitors, id) {
    for m in monitors {
        if int_field(m, "id") == id {
            return Some(m);
        }
    }
    None
}

// Whether the window is on a screen right now — which is *not* what hyprctl's per-window
// `visible` says. Upstream defines that one as `!m_hidden && m_isMapped && surface &&
// visibleByAlpha()` (CWindow::visible): it describes the window's own surface inside its
// workspace, not which workspace an output is showing. Measured on this session (Hyprland
// 0.56), a mapped, unhidden window on a workspace no output is showing answers
// `visible: true` — so it cannot be used to decide whether acting on it would land on what is
// on screen. On screen means: mapped, not hidden, and either the window's workspace is one an
// output is showing, or the window is pinned — a pinned window is rendered on whatever
// workspace its output is showing, whatever its own workspace field says
// (IHyprRenderer::shouldRenderWindow returns true for a pinned window). Neither this nor
// anything else here accounts for occlusion: a window behind a fullscreen one is reported on
// screen, and the capture and input verbs say in their answers that they cannot bind to a
// window.
fn window_on_screen(monitors, w) {
    if !bool_field(w, "mapped") {
        return false;
    }
    if bool_field(w, "hidden") {
        return false;
    }
    if bool_field(w, "pinned") {
        match monitor_by_id(monitors, int_field(w, "monitor")) {
            Some(m) => !bool_field(m, "disabled"),
            None => false,
        }
    } else {
        workspace_shown(monitors, workspace_of_window(w))
    }
}

// What a later call is held to: identity (address, stable id, pid, class), the
// workspace, and the geometry that was on screen. The title is deliberately not in it —
// a terminal rewrites its title as you work in it, and refusing a click because a shell
// changed its prompt would be a false alarm.
fn fingerprint(w) {
    let at = pair(w, "at");
    let size = pair(w, "size");
    let ws = workspace_of_window(w);
    `${str_field(w, "address")}|${str_field(w, "stableId")}|${int_field(w, "pid")}|${str_field(w, "class")}|${str_field(ws, "name")}|${at[0]},${at[1]}|${size[0]}x${size[1]}`
}

fn find_window(clients, address) {
    for w in clients {
        if str_field(w, "address") == address {
            return Some(w);
        }
    }
    None
}

// The fields that differ between the fingerprint the caller saw and the one on screen
// now, so a refusal names what moved instead of only saying "stale".
fn explain(expected, got_fp) {
    let a = expected.split("|").collect::<Vec>();
    let b = got_fp.split("|").collect::<Vec>();
    if a.len() != 7 || b.len() != 7 {
        return "";
    }
    let names = ["address", "stable_id", "pid", "class", "workspace", "at", "size"];
    let out = [];
    let i = 0;
    while i < 7 {
        if a[i] != b[i] {
            out.push(`${names[i]} ${a[i]} -> ${b[i]}`);
        }
        i += 1;
    }
    if out.len() == 0 {
        ""
    } else {
        " (" + join(out, ", ") + ")"
    }
}

// `None` means the window is the one the caller inspected; `Some(reason)` is a refusal.
fn check_target(clients, address, expect) {
    let w = match find_window(clients, address) {
        Some(w) => w,
        None => return Some(`no open window has address ${address} any more. Hyprland reuses addresses, so a window that appeared with the same address is not the one inspected — inspect again and use the new fingerprint`),
    };
    if expect == "" {
        return Some(`expect is required: the fingerprint hyprland_inspect reported for ${address}. Without it a window that moved or died since the inspection would be acted on as if it were the one seen`);
    }
    let now = fingerprint(w);
    if expect != now {
        return Some(`target ${address} is not the window that was inspected: the fingerprint was ${expect}, it is now ${now}${explain(expect, now)} — inspect again and act on the window as it is now`);
    }
    None
}

// The window's own summary, for the answer a call gives back.
fn describe(w) {
    let at = pair(w, "at");
    let size = pair(w, "size");
    let ws = workspace_of_window(w);
    `${str_field(w, "address")} class=${str_field(w, "class")} title="${str_field(w, "title")}" pid=${int_field(w, "pid")} ws=${int_field(ws, "id")} at=${at[0]},${at[1]} size=${size[0]}x${size[1]}`
}

fn looks_like_address(s) {
    if !s.starts_with("0x") || s.len() < 3 || s.len() > 20 {
        return false;
    }
    for c in s.get(2..).unwrap_or("").chars() {
        let hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
        if !hex {
            return false;
        }
    }
    true
}

// Names that go into a Lua expression (a monitor name, a workspace name) are held to a
// plain charset and refused otherwise, so nothing a model writes can become Lua.
fn plain_name(s) {
    if s == "" {
        return false;
    }
    for c in s.chars() {
        let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
            || c == '.' || c == '_' || c == '-' || c == '+' || c == ':';
        if !ok {
            return false;
        }
    }
    true
}

fn num_text(n) {
    let i = n as i64;
    if (i as f64) == n {
        `${i}`
    } else {
        `${n}`
    }
}

async fn sleep_ms(ms) {
    if ms <= 0 {
        return Ok(());
    }
    let secs = `${ms as f64 / 1000.0}`;
    let out = eidolon::exec("sleep", [secs], Some(EXEC_TIMEOUT_S)).await?;
    if exec_failed(out) {
        return Err(`sleep ${secs} failed: ${out.trim()}`);
    }
    Ok(())
}

// ---------------------------------------------------------------------------
// The input clients. Both are short-lived programs that create a virtual device, send
// what they were asked for and exit; nothing here keeps running, so there is no service.
// `command -v` asks the shell whether a client is there *without running it*: a missing
// one is a named refusal rather than a spawn error.

const INPUT_POINTER = "wlrctl";
const INPUT_KEYBOARD = "wtype";

async fn require_tool(name) {
    let out = eidolon::exec("sh", ["-c", `command -v ${name}`], Some(5)).await?;
    if exec_failed(out) || out.trim() == "" {
        return Err(`the input client \`${name}\` is not on PATH, and this Hyprland has no primitive of its own for pointer buttons, scroll or text. See the plugin's README: the runtime package provides grim, wlrctl and wtype`);
    }
    Ok(out.trim())
}

async fn run_client(name, args) {
    let out = eidolon::exec(name, args, Some(EXEC_TIMEOUT_S)).await?;
    if exec_failed(out) {
        return Err(`${name} ${join(args, " ")} failed: ${out.trim()}`);
    }
    Ok(out.trim())
}

// Buttons are always named and checked against the client's own three, never left to
// default: wlrctl's `pointer click` with no argument clicks the left button, which is
// not something to fall into by omitting a field.
const BUTTONS = ["left", "right", "middle"];

fn checked_button(input) {
    let b = word(input, "button");
    if b == "" {
        return Err(`button is required: "left", "right" or "middle". It is never defaulted — the client's own default is a bare left click`);
    }
    for ok in BUTTONS {
        if b == ok {
            return Ok(b);
        }
    }
    Err(`button is "left", "right" or "middle", not "${b}"`)
}

// Where in the window the caller means, and where that is on the layout. Window-relative
// by default (the coordinates a screenshot shows); `global: true` takes layout
// coordinates instead, which must fall inside the window's rectangle.
fn target_point(w, input, x, y) {
    let at = pair(w, "at");
    let size = pair(w, "size");
    if !geometry_known(w) {
        return Err(`hyprctl reports no geometry for ${str_field(w, "address")}, so a point cannot be placed in it`);
    }
    if bool_input(input, "global", false) {
        if x < at[0] || y < at[1] || x >= at[0] + size[0] || y >= at[1] + size[1] {
            return Err(`the point ${x},${y} is outside the window's ${size[0]}x${size[1]} at ${at[0]},${at[1]} in layout coordinates`);
        }
        return Ok(#{ x: x, y: y, local: #{ x: x - at[0], y: y - at[1] } });
    }
    if x < 0 || y < 0 || x >= size[0] || y >= size[1] {
        return Err(`the point ${x},${y} is outside the window's ${size[0]}x${size[1]} (window-relative, top-left origin; pass global: true for layout coordinates)`);
    }
    Ok(#{ x: at[0] + x, y: at[1] + y, local: #{ x: x, y: y } })
}

// The pointer is moved by displacement: wlrctl's virtual pointer has `move <dx> <dy>`
// and no absolute form, so the compositor's cursor position is read and the difference
// sent. That is two calls, and the position is read back before anything is clicked —
// if the pointer did not arrive, the caller gets a refusal instead of a click in the
// wrong place. A person (or another client) moving the pointer between the read and the
// move is not detectable from here, and neither is a window moving between the
// re-check and the click; the result says so.
async fn point_pointer_at(x, y, settle) {
    let cursor = hypr_json(["-j", "cursorpos"]).await?;
    let from = #{ x: int_field(cursor, "x"), y: int_field(cursor, "y") };
    let dx = x - from.x;
    let dy = y - from.y;
    if dx != 0 || dy != 0 {
        run_client(INPUT_POINTER, ["pointer", "move", `${dx}`, `${dy}`]).await?;
        sleep_ms(settle).await?;
    }
    let after = hypr_json(["-j", "cursorpos"]).await?;
    let to = #{ x: int_field(after, "x"), y: int_field(after, "y") };
    if to.x != x || to.y != y {
        return Err(`the pointer was moved from ${from.x},${from.y} by ${dx},${dy} but the compositor says it is at ${to.x},${to.y}, not ${x},${y} — the caller's screen may be moving under it, so nothing was clicked or scrolled`);
    }
    Ok(#{ from: from, to: to })
}

// Everything that has to be true *at the instant* an input event goes out, read again right
// before it, in one place: the window is still the one that was inspected, still mapped,
// unhidden and taking input; the monitor it is on is still showing its workspace; the point is
// still inside its rectangle; and the pointer is actually there.
//
// The checks made before the pointer moved are not enough for this. A window's fingerprint
// carries its own workspace, so it does *not* change when an output switches the workspace it
// shows — the window is the same window on the same workspace, and now it is nowhere on screen.
// A click aimed at layout x,y would then land on whatever that output is showing at x,y instead.
// Reading the monitors again is what catches it, and reading them here rather than once is what
// makes a multi-press stop at the press whose world changed.
//
// These reads and the input event are still separate compositor calls, and no compositor
// primitive here binds an event to a window (the input path is a virtual device; see the
// plugin's README) — the answer says so rather than claiming the race is closed.
async fn revalidate_at_pointer(address, expect, point) {
    let monitors = hypr_json(["-j", "monitors"]).await?;
    let clients = hypr_json(["-j", "clients"]).await?;
    match check_target(clients, address, expect) {
        None => {}
        Some(reason) => return Err(reason),
    }
    let w = match find_window(clients, address) {
        Some(w) => w,
        None => return Err(`no window with address ${address} any more`),
    };
    if !bool_field(w, "mapped") {
        return Err(`window ${address} is not mapped any more (withdrawn or still mapping)`);
    }
    if bool_field(w, "hidden") {
        return Err(`window ${address} is hidden again: the compositor is not drawing it`);
    }
    if !bool_field(w, "acceptsInput") {
        return Err(`window ${address} stopped accepting input`);
    }
    if !window_on_screen(monitors, w) {
        let ws = workspace_of_window(w);
        return Err(`the output showing this window switched away from workspace ${int_field(ws, "id")} while the pointer was moving, so ${address} is on screen nowhere now and ${point.x},${point.y} is not on it. hyprland_focus would switch to that workspace — a visible change this tool will not make on its own`);
    }
    let at = pair(w, "at");
    let size = pair(w, "size");
    if point.x < at[0] || point.y < at[1] || point.x >= at[0] + size[0] || point.y >= at[1] + size[1] {
        return Err(`the point ${point.x},${point.y} is outside the window's ${size[0]}x${size[1]} at ${at[0]},${at[1]} now`);
    }
    let cursor = hypr_json(["-j", "cursorpos"]).await?;
    let now = #{ x: int_field(cursor, "x"), y: int_field(cursor, "y") };
    if now.x != point.x || now.y != point.y {
        return Err(`the compositor says the pointer is at ${now.x},${now.y}, not ${point.x},${point.y} any more: it moved between the move and this instant`);
    }
    Ok(())
}

// Whichever window the compositor has focused, and whether it is the one aimed at.
// Injection through a virtual device is not bound to a window: the compositor sends the
// keys to whatever holds the keyboard focus at that instant, so the only honest check is
// immediately before, and again after to say whether the focus moved during.
async fn active_address() {
    let active = hypr_json(["-j", "activewindow"]).await?;
    Ok(str_field(active, "address"))
}

fn focus_window_expr(address) {
    `(function()
  local w = hl.get_window("address:${address}")
  if w == nil then error("stale target: no window has address ${address}") end
  if tostring(w.address) ~= "${address}" then error("address ${address} is now " .. tostring(w.address)) end
  return hl.dsp.focus({ window = w })
end)()`
}

// Focus the window aimed at, on the caller's explicit say-so, and report what the
// compositor did with it. Focusing a window that is on another workspace switches to
// that workspace, which is a visible change to the operator's session.
async fn ensure_focused(input, w, allow_focus) {
    let address = str_field(w, "address");
    let now = active_address().await?;
    if now == address {
        return Ok("");
    }
    if !allow_focus {
        return Err(`the focused window is ${now}, not ${address}: typing or keys would go to the wrong client. Pass focus_first: true to focus ${address} first — that is a visible change to the session, which is why it is not done by default`);
    }
    let out = match hypr(["dispatch", focus_window_expr(address)]).await {
        Ok(out) => out,
        Err(e) => return Err(`the compositor would not focus ${address}: ${e}`),
    };
    if out.trim() != "ok" {
        return Err(`the compositor would not focus ${address}: ${out.trim()}`);
    }
    let after = active_address().await?;
    if after != address {
        return Err(`asked the compositor to focus ${address}, it answered ok, and the focused window is ${after} — refusing to type into a window that is not the one aimed at`);
    }
    Ok("focused it first")
}
