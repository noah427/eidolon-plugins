// `librewolf_navigate`: move an enabled tab to another address *on the origin it
// is enabled on*. A cross-origin move is refused here: it needs a person.
pub fn manifest() {
    #{
        name: "librewolf_navigate",
        description: "Move an enabled LibreWolf tab to another address on the origin it is enabled on (same scheme, host and port; a relative url is resolved against the page's current one). A different origin is refused — a cross-origin navigation suspends the enablement and needs a person to click the extension's toolbar button again, so no call can do it. The navigation loads a new document, so this tab's enablement continues (if the result is still on that origin) while every ref and document the tab had becomes stale: take a fresh librewolf_structure afterwards. It changes what the tab is showing, which is why it is mutating.",
        approval: "mutating",
        input_schema: #{
            "type": "object",
            "properties": #{
                "tab_id": #{
                    "type": "integer",
                    "description": "The id of an enabled tab, from librewolf_tabs or librewolf_status.",
                },
                "url": #{
                    "type": "string",
                    "description": "An absolute http(s) url on the same origin as the enabled tab, or one relative to the page it is showing.",
                },
            },
            "required": ["tab_id", "url"],
        },
    }
}

pub async fn call(input) {
    call_service("navigate", input).await
}
// Everything below is the same in every librewolf_*.rn: upstream eidolon
// compiles each tool file on its own, and a tool file is meant to be handed
// over whole.

// The bridge host (../service). LibreWolf starts it, not eidolon: the browser
// runs it as its native messaging host, so there is no `eidolon plugins service
// start librewolf` to name. Change the port here and the host's
// EIDOLON_LIBREWOLF_PORT together.
fn service() {
    #{
        name: "librewolf",
        base_url: "http://127.0.0.1:8091",
        token_file: "~/.config/eidolon/librewolf.token",
        auth: #{ header: "Authorization", prefix: "Bearer " },
        timeout_s: 180,
    }
}

// POST {method, args} to /call; the answer is {ok, result} or {ok: false, error}.
async fn call_service(method, args) {
    let body = json::to_string(#{ "method": method, "args": args })?;
    // A dial that fails means the browser is not running with the extension, or
    // no profile has it loaded. There is no command that fixes that, so the
    // answer names the one act that does instead of leaving a refusal to be read.
    let sent = match eidolon::api_request(service(), "POST", "/call", Some(body)).await {
        Ok(r) => r,
        Err(e) => {
            return Err(`the LibreWolf bridge is not answering on 127.0.0.1:8091 — LibreWolf must be running with the librewolf bridge extension connected, because the browser starts this host and eidolon cannot; see the plugin's README (Prerequisites). The dial failed with: ${e}`);
        }
    };
    let reply = json::from_string(sent)?;
    if reply.status != 200 {
        return Err(`librewolf bridge answered ${reply.status}: ${reply.body}`);
    }
    let out = json::from_string(reply.body)?;
    if out.ok { Ok(out.result) } else { Err(out.error) }
}
