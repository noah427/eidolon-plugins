// Test fixture only: seed the plugin's own store so the lifecycle handlers can be
// driven with a known adoption and a rank on this run's own session. Not shipped.
//
// The ledger is one key — `store` — holding `adoptions`, `notices` and `gaps`; `ranks`
// is a key of its own. This seeds the first two and leaves the rest empty, which is
// the shape an `adopt` followed by a `rank` leaves behind.

pub fn manifest() {
    #{
        name: "coordinator_seed",
        description: "Test fixture: write one adoption into the ledger and one rank row into this run's plugin state.",
        approval: "mutating",
        input_schema: #{ "type": "object", "properties": #{} },
    }
}

async fn revision_of(key) {
    let raw = eidolon::plugin_state_read(#{ "key": key }).await?;
    let reply = json::from_string(raw)?;
    match reply.get("revision") {
        Some(v) => Ok(v),
        None => Ok(0),
    }
}

pub async fn call(input) {
    let raw = eidolon::swarm_call("roster", #{}).await?;
    let roster = json::from_string(raw)?;
    let me = match roster.get("me") {
        Some(m) => {
            if m is Object {
                m
            } else {
                return Err("the test needs a live roster row for this run (`me`), none was published");
            }
        }
        None => return Err("the test needs a live roster row for this run (`me`), none was published"),
    };
    let session = match me.get("session") {
        Some(s) => `${s}`,
        None => return Err("this run's roster row carries no session id"),
    };
    let store = #{
        "adoptions": [
            #{ "epoch": 1, "coordinator": "c1", "worker": "w1", "name": "grinder", "note": "" },
        ],
        "notices": [],
        "gaps": [],
    };
    let ranks = [
        #{ "session": session, "rank": "tribunus", "prefix": "Tribunus", "by": "c1" },
    ];
    // Seeded at whatever revision each key stands at, not at 0: the plugin's own handlers run
    // at session start and one of them writes the scan's words into `store` before this
    // fixture is dispatched. A fixture that assumed it was the only writer masked exactly that.
    let a = eidolon::plugin_state_write(#{ "key": "store", "value": json::to_string(store)?, "revision": revision_of("store").await? }).await?;
    let r = eidolon::plugin_state_write(#{ "key": "ranks", "value": json::to_string(ranks)?, "revision": revision_of("ranks").await? }).await?;
    Ok(`seeded ${a} ${r}`)
}
