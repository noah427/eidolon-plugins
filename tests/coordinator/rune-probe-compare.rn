pub fn workflow() {
    #{
        name: "rune-probe-compare",
        description: "locate the empty-result defect: compare large strings and answer",
        approval: "mutating",
        params: #{ "type": "object", "properties": #{} },
    }
}

pub async fn run(args) {
    let out = "";
    let small = match eidolon::tool_call("coordinator_probe_compare", #{}).await {
        Ok(t) => `OK len=${t.len()} ${t}`,
        Err(e) => `ERR len=${e.len()} ${e}`,
    };
    out += `SMALL ${small}\n`;
    let big = match eidolon::tool_call("coordinator_probe_compare", #{}).await {
        Ok(t) => `OK len=${t.len()}`,
        Err(e) => `ERR len=${e.len()}`,
    };
    out += `BIG ${big}\n`;
    Ok(out)
}
